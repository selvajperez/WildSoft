---
import { Image } from 'astro:assets';
import wildfoxCientifico from '../assets/lab/wildfox-cientifico.png';
---
<section class="lab-destacado" id="lab" aria-labelledby="lab-titulo">
  <div class="lab-card wrap">
    <div class="lab-texto">
      <p class="lab-kicker">Automatización y extracción de datos</p>
      <h2 id="lab-titulo">WildSoft-Lab</h2>
      <p class="lab-frase">¿Y si probamos?</p>
      <a class="btn btn-primary" href="/lab">Entrar al laboratorio</a>
    </div>

    <div class="lab-figura">
      <Image
        src={wildfoxCientifico}
        alt="WildFox científico, con guardapolvo y anteojos, piensa frente a su notebook en un escritorio de laboratorio con tubos de ensayo, libros, un robot y pizarras de ideas."
        widths={[360, 540, 720]}
        sizes="(max-width: 760px) 100vw, 400px"
        format="webp"
        quality={82}
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .lab-destacado{ padding: 90px 60px; }

  .lab-card{
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 56px;
    background: var(--negro);
    color: var(--crema);
    border-radius: 24px;
    padding: 56px 64px;
    overflow: hidden;
  }
  /* Un resplandor cálido detrás de la ilustración, sin competir con ella */
  .lab-card::before{
    content: '';
    position: absolute;
    right: -120px; top: 50%;
    width: 560px; height: 560px;
    transform: translateY(-50%);
    background: radial-gradient(circle, rgba(236,115,35,0.22) 0%, rgba(236,115,35,0) 68%);
    pointer-events: none;
  }

  .lab-texto{ position: relative; }
  .lab-kicker{
    font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em;
    text-transform: uppercase; color: #B9C05A; margin: 0 0 20px;
  }
  .lab-card h2{
    font-size: clamp(40px, 5vw, 62px); font-weight: 800; line-height: 1.05; color: #fff; margin: 0 0 18px;
  }
  .lab-frase{
    font-family: var(--font-secundaria); font-style: italic; font-size: clamp(26px, 3vw, 36px);
    line-height: 1.3; color: var(--naranja); margin: 0 0 38px;
  }

  .lab-figura{ position: relative; max-width: 400px; width: 100%; justify-self: end; }
  .lab-figura :global(img){
    width: 100%; height: auto; display: block; border-radius: 18px;
    box-shadow: 0 28px 56px -16px rgba(0,0,0,0.6);
  }

  @media (max-width: 900px){
    .lab-card{ padding: 44px 36px; gap: 36px; }
  }

  @media (max-width: 760px){
    .lab-destacado{ padding: 40px 24px; }
    .lab-card{
      grid-template-columns: 1fr; gap: 30px; padding: 22px 22px 34px; border-radius: 20px;
    }
    .lab-card::before{ right: 50%; top: 28%; transform: translate(50%, -50%); width: 420px; height: 420px; }
    /* En móvil la ilustración va primero: es la protagonista */
    .lab-figura{ order: -1; max-width: none; justify-self: stretch; }
    .lab-figura :global(img){ border-radius: 14px; }
    .lab-kicker{ font-size: 11px; letter-spacing: 0.08em; margin-bottom: 14px; text-wrap: balance; }
    .lab-card h2{ font-size: 38px; margin-bottom: 12px; }
    .lab-frase{ font-size: 25px; margin-bottom: 26px; }
  }
</style>
