---
const areas = [
  {
    titulo: 'Datos y análisis',
    texto: 'Dashboards, visualizaciones e indicadores que transforman información en decisiones claras.',
    // Categoría con más de un caso publicado (Maxiconsumo, Hospital Analytics): enlaza a la página índice.
    href: '/proyectos/datos-y-analisis',
    caso: 'Maxiconsumo',
    cta: 'Ver casos de estudio',
  },
  {
    titulo: 'Web y presencia digital',
    texto: 'Sitios, portfolios y experiencias web pensadas para comunicar con claridad y funcionar en distintos dispositivos.',
    // Primer caso publicado de esta área; enlaza directo al caso mientras sea el único.
    // Cuando haya más de un caso, este href debería apuntar a una página índice de la categoría.
    href: '/proyectos/proyecto-jardin-estudio',
    caso: 'Proyecto Jardín Estudio',
  },
  {
    titulo: 'E-commerce',
    texto: 'Tiendas online, catálogos y soluciones orientadas a organizar productos y facilitar la experiencia de compra.',
    // Primer caso publicado de esta área; enlaza directo al caso mientras sea el único.
    // Cuando haya más de un caso, este href debería apuntar a una página índice de la categoría.
    href: '/proyectos/bissu-cosmeticos',
    caso: 'Bissú Cosméticos',
    cta: 'Ver caso de estudio',
  },
  {
    titulo: 'Sistemas y automatización',
    texto: 'Procesos, herramientas e integraciones que ordenan tareas, conectan información y reducen trabajo repetitivo.',
    // Primer caso publicado de esta área; enlaza directo al caso mientras sea el único.
    // Cuando haya más de un caso, este href debería apuntar a una página índice de la categoría.
    href: '/proyectos/purissimus',
    caso: 'Purissimus S.A.',
    cta: 'Ver caso de estudio',
  },
];

const destacados = [
  {
    href: '/proyectos/maxiconsumo',
    kicker: 'Caso de estudio · Datos y Business Intelligence',
    titulo: 'Maxiconsumo: de datos dispersos a un dashboard comercial en Power BI',
    texto: 'Ventas, productos, clientes y métodos de pago consolidados en un dashboard interactivo, con análisis exploratorio en Python.',
    link: 'Ver el caso completo →',
  },
  {
    href: '/proyectos/redeterminacion-precios',
    kicker: 'Caso de estudio',
    titulo: 'Modernización del Sistema de Redeterminación de Precios',
    texto: 'Transformación de un proceso normativo y administrativo en una solución digital para la gestión de obra pública.',
    link: 'Ver el caso completo →',
  },
];
---
<section class="section-crema" id="proyectos">
  <div class="section-head">
    <h2>Soluciones para distintos desafíos digitales</h2>
    <p>Proyectos desarrollados desde diferentes áreas de la tecnología, combinando experiencia, análisis y una mirada práctica para responder a necesidades concretas.</p>
  </div>
  <div class="proyectos-body wrap">
    <div class="proyectos-grid">
      {areas.map((a) => (
        a.href ? (
          <a class="area-card area-card-link" href={a.href}>
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
            <span class="area-link">{a.cta || `Ver caso: ${a.caso} →`}</span>
          </a>
        ) : (
          <div class="area-card">
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
          </div>
        )
      ))}
    </div>
    <div class="proyectos-img">
      <img src="/images/proyectos.png" alt="WildFox trabajando entre dashboards, código y bases de datos" />
    </div>
  </div>

  {destacados.map((d) => (
    <a class="caso-destacado wrap" href={d.href}>
      <div class="caso-kicker">{d.kicker}</div>
      <h3>{d.titulo}</h3>
      <p>{d.texto}</p>
      <span class="caso-link">{d.link}</span>
    </a>
  ))}

  <div class="center-btn"><a class="btn btn-primary" href="#proyectos">Explorar proyectos</a></div>
</section>

<style>
  .proyectos-body{ display: flex; align-items: center; gap: 70px; padding: 0; }
  .proyectos-grid{ flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .area-card{
    background: var(--fondo-claro);
    border-radius: 16px;
    padding: 28px 26px;
    border-left: 5px solid var(--naranja);
  }
  .area-card h3{ font-size: 19px; font-weight: 700; margin: 0 0 10px; color: var(--negro); }
  .area-card p{ font-size: 15px; line-height: 1.6; color: var(--gris); margin: 0; }
  .area-card-link{ display: block; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .area-card-link:hover{ transform: translateY(-3px); box-shadow: 0 16px 30px -18px rgba(21,22,18,0.35); }
  .area-link{ display: block; font-size: 13.5px; font-weight: 700; color: var(--naranja); margin-top: 14px; }
  .proyectos-img{ flex: 0 1 420px; min-width: 0; }
  .proyectos-img img{ width: 100%; border-radius: 20px; }

  .caso-destacado{
    display: block; margin-top: 60px; padding: 44px 48px; border-radius: 20px;
    background: var(--negro); color: var(--crema);
  }
  .caso-kicker{
    font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--verde); margin-bottom: 14px;
  }
  .caso-destacado h3{ font-size: 24px; font-weight: 800; color: #fff; margin: 0 0 12px; }
  .caso-destacado p{ font-size: 15px; line-height: 1.65; color: #D9D2C4; margin: 0 0 20px; max-width: 640px; }
  .caso-link{ font-size: 14.5px; font-weight: 700; color: var(--naranja); }

  @media (max-width: 760px){
    .proyectos-body{ flex-direction: column; gap: 0; }
    .proyectos-grid{ display: flex; flex-direction: column; gap: 16px; width: 100%; }
    .area-card{ padding: 22px 20px; border-radius: 14px; }
    .area-card h3{ font-size: 17.5px; margin-bottom: 8px; }
    .area-card p{ font-size: 14.5px; }
    .proyectos-img{ flex: none; width: 100%; margin-bottom: 30px; }

    .caso-destacado{ margin-top: 30px; padding: 30px 26px; border-radius: 16px; }
    .caso-destacado h3{ font-size: 19px; margin-bottom: 10px; }
    .caso-destacado p{ font-size: 14px; margin-bottom: 16px; }
    .caso-link{ font-size: 14px; }
  }
</style>
