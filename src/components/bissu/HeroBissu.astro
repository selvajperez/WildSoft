---
---
<section class="bhero" id="bissu-hero">
  <div class="wrap bhero-inner">
    <div class="bhero-left">
      <div class="kicker">Caso de estudio · E-commerce</div>
      <h1>Bissú Cosméticos</h1>
      <p class="subtitulo">De la venta por catálogo a un ecosistema digital integrado</p>
      <p class="bajada">Sitio institucional, tienda online y contenidos audiovisuales para acompañar la transformación comercial de la marca entre 2010 y 2015.</p>
      <div class="datos">
        <div><b>País</b> <span>México · 2010–2015</span></div>
        <div><b>Stack</b> <span>Joomla · PrestaShop · HTML · CSS · YouTube</span></div>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href="#contexto">Explorar el caso</a>
        <a class="btn btn-secondary" href="#evidencias">Ver evidencias</a>
      </div>
    </div>
    <div class="bhero-right">
      <svg viewBox="0 0 560 560" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ilustración editorial: transformación de un catálogo impreso en un ecosistema digital">
        <!-- Catálogo impreso -->
        <g stroke="#151612" stroke-width="1.2" fill="none" opacity="0.6">
          <rect x="40" y="70" width="180" height="240" rx="4" />
          <line x1="40" y1="120" x2="220" y2="120" />
        </g>
        <g fill="none" stroke="#151612" stroke-width="1.1" opacity="0.5">
          <line x1="58" y1="100" x2="150" y2="100" />
          <line x1="58" y1="108" x2="130" y2="108" />
        </g>
        <circle cx="80" cy="165" r="16" fill="#C97B84" stroke="none" />
        <circle cx="125" cy="165" r="16" fill="#6B3F52" stroke="none" />
        <circle cx="170" cy="165" r="16" fill="#C9A227" stroke="none" opacity="0.9" />
        <g stroke="#151612" stroke-width="1" fill="none" opacity="0.45">
          <line x1="58" y1="200" x2="200" y2="200" />
          <line x1="58" y1="214" x2="185" y2="214" />
          <line x1="58" y1="228" x2="195" y2="228" />
        </g>
        <rect x="58" y="250" width="60" height="42" rx="3" fill="none" stroke="#151612" stroke-width="1" opacity="0.5" />
        <rect x="128" y="250" width="60" height="42" rx="3" fill="none" stroke="#151612" stroke-width="1" opacity="0.5" />

        <!-- Flecha de transformación -->
        <g stroke="#EC7323" stroke-width="1.8" fill="none">
          <path d="M 230 190 C 270 190, 270 190, 300 190" />
          <path d="M 292 182 L 300 190 L 292 198" />
        </g>

        <!-- Ecosistema digital: browser frame -->
        <g stroke="#151612" stroke-width="1.3" fill="none" opacity="0.75">
          <rect x="320" y="100" width="200" height="150" rx="6" />
          <line x1="320" y1="122" x2="520" y2="122" />
        </g>
        <circle cx="333" cy="111" r="3" fill="#151612" opacity="0.4" stroke="none" />
        <circle cx="344" cy="111" r="3" fill="#151612" opacity="0.4" stroke="none" />
        <circle cx="355" cy="111" r="3" fill="#151612" opacity="0.4" stroke="none" />
        <g fill="#FDEEDB" stroke="#151612" stroke-width="0.8" opacity="0.9">
          <rect x="333" y="134" width="45" height="45" rx="3" />
          <rect x="384" y="134" width="45" height="45" rx="3" />
          <rect x="435" y="134" width="45" height="45" rx="3" />
        </g>
        <g fill="none" stroke="#151612" stroke-width="1" opacity="0.4">
          <line x1="333" y1="196" x2="480" y2="196" />
          <line x1="333" y1="208" x2="460" y2="208" />
        </g>
        <rect x="333" y="222" width="70" height="18" rx="9" fill="#71781A" opacity="0.85" />

        <!-- Tienda: carrito -->
        <g transform="translate(340 300)" stroke="#151612" stroke-width="1.3" fill="none" opacity="0.75">
          <path d="M0 0 h14 l10 46 h60 l12 -34 h-78" />
          <circle cx="24" cy="58" r="6" />
          <circle cx="74" cy="58" r="6" />
        </g>

        <!-- YouTube: play -->
        <g transform="translate(460 300)">
          <rect x="0" y="0" width="70" height="46" rx="8" fill="#151612" opacity="0.85" />
          <path d="M28 14 L46 23 L28 32 Z" fill="#FBF2E2" />
        </g>

        <g font-family="JetBrains Mono, monospace" font-size="10" fill="#302F2E" opacity="0.65">
          <text x="42" y="330">CATÁLOGO IMPRESO</text>
          <text x="335" y="270">SITIO · TIENDA</text>
          <text x="340" y="368">E-COMMERCE</text>
          <text x="458" y="368">YOUTUBE</text>
        </g>
      </svg>
      <p class="ilustracion-nota">Ilustración editorial — recreación conceptual, no captura del sitio original.</p>
    </div>
  </div>
</section>

<style>
  .bhero{ background: var(--crema); padding-top: 70px; padding-bottom: 90px; }
  .bhero-inner{ display: flex; align-items: center; gap: 64px; }
  .bhero-left{ flex: 0 0 46%; }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 22px; }
  .bhero-left h1{ font-size: 40px; font-weight: 800; line-height: 1.14; color: var(--negro); margin: 0 0 14px; }
  .subtitulo{ font-family: var(--font-secundaria); font-style: italic; font-size: 21px; color: var(--gris); margin: 0 0 20px; }
  .bajada{ font-size: 16.5px; line-height: 1.65; color: var(--gris); margin: 0 0 26px; max-width: 460px; }
  .datos{ margin-bottom: 26px; }
  .datos div{ display: flex; gap: 10px; font-size: 13.5px; padding: 10px 0; border-top: 1px solid rgba(21,22,18,0.12); color: var(--gris); }
  .datos div:first-child{ border-top: none; }
  .datos b{ color: var(--negro); font-weight: 700; min-width: 70px; flex: 0 0 70px; }
  .btn-row{ display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }

  .bhero-right{ flex: 1; }
  .ilustracion-nota{ font-size: 11.5px; color: var(--gris); opacity: 0.65; text-align: center; margin: 14px 0 0; font-style: italic; }

  @media (max-width: 760px){
    .bhero{ padding-top: 40px; padding-bottom: 50px; }
    .bhero-inner{ flex-direction: column; gap: 30px; }
    .bhero-left{ flex: none; }
    .bhero-left h1{ font-size: 27px; line-height: 1.2; margin-bottom: 12px; }
    .subtitulo{ font-size: 17px; }
    .bajada{ font-size: 15px; margin-bottom: 22px; max-width: none; }
    .datos div{ flex-direction: column; gap: 2px; font-size: 13px; }
    .datos b{ min-width: 0; flex: none; }
    .btn-row{ flex-direction: column; align-items: stretch; gap: 12px; }
    .bhero-right{ width: 100%; }
  }
</style>
