---
const resultados = [
  'Presencia ampliada más allá de la venta tradicional por catálogo.',
  'Nuevo canal de venta directa al consumidor final.',
  'Presentación más dinámica y actualizable de productos, colecciones y campañas.',
  'Contenidos comerciales y audiovisuales integrados con los productos de la tienda.',
  'Comunicación más frecuente con consumidoras y revendedoras.',
  'Mejor visibilidad de la marca en buscadores mediante acciones de SEO.',
];
---
<section class="jres" id="resultados">
  <div class="wrap">
    <div class="kicker">Resultados</div>
    <div class="res-grid">
      {resultados.map((r) => (
        <div class="res-card">
          <span class="res-check">✓</span>
          <p>{r}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .jres{ background: var(--crema); }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 30px; text-align: center; }
  .res-grid{ display: grid; grid-template-columns: 1fr 1fr; gap: 20px; max-width: 980px; margin: 0 auto; }
  .res-card{ display: flex; align-items: flex-start; gap: 16px; background: #fff; border-radius: 14px; padding: 24px 22px; border-left: 4px solid var(--naranja); }
  .res-check{ flex: 0 0 24px; width: 24px; height: 24px; border-radius: 50%; background: var(--verde); color: #fff; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .res-card p{ font-size: 15px; line-height: 1.5; color: var(--negro); margin: 0; font-weight: 600; }

  @media (max-width: 760px){
    .res-grid{ grid-template-columns: 1fr; gap: 14px; }
    .res-card{ padding: 18px; border-radius: 12px; }
    .res-card p{ font-size: 14px; }
  }
</style>
