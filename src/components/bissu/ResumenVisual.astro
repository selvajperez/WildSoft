---
const icons: Record<string, string> = {
  catalogo: '<path d="M3 5.5c2.8-1.3 5.7-1.3 8.5 0v14c-2.8-1.3-5.7-1.3-8.5 0z"/><path d="M21 5.5c-2.8-1.3-5.7-1.3-8.5 0v14c2.8-1.3 5.7-1.3 8.5 0z"/>',
  lapiz: '<rect x="9" y="2.5" width="6" height="6" rx="1"/><path d="M9 8.5h6l-1.2 11.5a1.8 1.8 0 01-1.8 1.6h0a1.8 1.8 0 01-1.8-1.6z"/>',
  pantallas: '<rect x="2.5" y="9.5" width="6" height="6" rx="1.3"/><rect x="9" y="4" width="6" height="6" rx="1.3"/><rect x="15.5" y="9.5" width="6" height="6" rx="1.3"/><path d="M8.5 11.5L10 9M15.5 11.5L14 9"/>',
  bolsa: '<path d="M6.5 8h11l-1 12.2a2 2 0 01-2 1.8h-5a2 2 0 01-2-1.8z"/><path d="M9 8V6a3 3 0 016 0v2"/>',
};

const etapas = [
  { n: '01', kicker: 'El desafío', titulo: 'Un modelo comercial basado en catálogos', linea: 'Papel impreso, revendedoras y poca presencia digital', icon: 'catalogo', color: 'rosa' },
  { n: '02', kicker: 'La transformación', titulo: 'Digitalización de la venta directa', linea: 'La experiencia de marca, ahora online', icon: 'lapiz', color: 'naranja' },
  { n: '03', kicker: 'El ecosistema', titulo: 'Plataformas conectadas', linea: 'Joomla, PrestaShop y YouTube trabajando en conjunto', icon: 'pantallas', color: 'turquesa', protagonista: true },
  { n: '04', kicker: 'La experiencia de marca', titulo: 'Una identidad consistente en todos los canales', linea: 'La misma identidad, del papel a la pantalla', icon: 'paleta', color: 'paleta' },
  { n: '05', kicker: 'El resultado', titulo: 'Apertura al consumidor final', linea: 'Venta directa online, sin perder la red actual', icon: 'bolsa', color: 'rosa' },
];

const componentes = ['Joomla', 'PrestaShop', 'YouTube', 'E-commerce', 'Contenido audiovisual', 'Identidad visual', 'Venta directa'];
---
<section class="bresumen" id="resumen-visual">
  <div class="wrap">
    <div class="bresumen-encabezado">
      <span class="kicker">Caso de estudio · Transformación digital y e-commerce</span>
      <h2>Bissú: del catálogo impreso a un ecosistema digital de venta directa</h2>
      <p class="subtitulo">Reconversión del modelo comercial mediante la integración de identidad de marca, sitio institucional, tienda online, contenidos audiovisuales y venta directa al consumidor.</p>
    </div>

    <div class="linea-tiempo">
      <div class="linea-conectora" aria-hidden="true"></div>
      {etapas.map((e, i) => (
        <div class={`etapa-card ${e.protagonista ? 'etapa-protagonista' : ''}`}>
          <span class="etapa-n">{e.n} · {e.kicker}</span>
          <div class={`etapa-icono icono-${e.color}`}>
            {e.icon === 'paleta' ? (
              <svg viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="#151612" stroke-width="1.4" opacity="0.5" />
                <circle cx="8.2" cy="8.2" r="2.4" fill="#C97B84" />
                <circle cx="15.8" cy="8.2" r="2.4" fill="#EC7323" />
                <circle cx="12" cy="16" r="2.4" fill="#3F8F8A" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[e.icon]} />
            )}
          </div>
          <h3>{e.titulo}</h3>
          <p>{e.linea}</p>
          {i < etapas.length - 1 && (
            <span class="etapa-flecha" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13"/><path d="M13 6l6 6-6 6"/></svg>
            </span>
          )}
        </div>
      ))}
    </div>

    <div class="componentes-franja">
      <span class="componentes-titulo">Componentes del ecosistema</span>
      <div class="componentes-fila">
        {componentes.map((c) => <span class="componente-chip">{c}</span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .bresumen{ background: var(--crema); padding: 70px 0; }

  .bresumen-encabezado{ text-align: center; max-width: 780px; margin: 0 auto 54px; }
  .kicker{ display: block; font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 18px; }
  .bresumen-encabezado h2{ font-size: 34px; font-weight: 800; line-height: 1.2; color: var(--negro); margin: 0 0 16px; }
  .subtitulo{ font-size: 15.5px; line-height: 1.65; color: var(--gris); margin: 0; }

  .linea-tiempo{ position: relative; display: flex; align-items: stretch; gap: 0; max-width: 1180px; margin: 0 auto 54px; }
  .linea-conectora{
    position: absolute; top: 74px; left: 6%; right: 6%; height: 2px;
    background: linear-gradient(90deg, #C97B84, #EC7323 25%, #3F8F8A 50%, #EC7323 75%, #C97B84);
    opacity: 0.4;
  }

  .etapa-card{
    position: relative; flex: 1; background: #fff; border: 1.5px solid rgba(21,22,18,0.14); border-radius: 16px;
    padding: 22px 18px 24px; margin: 0 8px; text-align: center; box-shadow: 0 16px 32px -22px rgba(21,22,18,0.28);
  }
  .etapa-n{ display: block; font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--naranja); opacity: 0.85; margin-bottom: 16px; }

  /* Tarjeta 03 protagónica */
  .etapa-card.etapa-protagonista{
    flex: 1.18; align-self: center; margin-top: -14px; margin-bottom: -14px; padding: 30px 20px 32px;
    border-color: #3F8F8A; border-width: 2px;
    box-shadow: 0 22px 44px -20px rgba(63,143,138,0.4);
  }
  .etapa-card.etapa-protagonista .etapa-icono{ width: 64px; height: 64px; }
  .etapa-card.etapa-protagonista .etapa-icono svg{ width: 32px; height: 32px; }
  .etapa-card.etapa-protagonista h3{ font-size: 16px; }

  .etapa-icono{
    width: 52px; height: 52px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
    margin: 0 auto 16px;
  }
  .etapa-icono svg{ width: 26px; height: 26px; stroke-width: 1.9; }
  .icono-rosa{ background: #C97B84; color: #fff; box-shadow: 0 8px 20px -6px rgba(201,123,132,0.75); }
  .icono-naranja{ background: var(--naranja); color: #fff; box-shadow: 0 8px 20px -6px rgba(236,115,35,0.7); }
  .icono-turquesa{ background: #3F8F8A; color: #fff; box-shadow: 0 8px 20px -6px rgba(63,143,138,0.75); }
  .icono-paleta{ background: var(--fondo-claro); box-shadow: 0 8px 20px -8px rgba(21,22,18,0.25); }

  .etapa-card h3{ font-size: 14.5px; font-weight: 800; color: var(--negro); margin: 0 0 8px; line-height: 1.3; }
  .etapa-card p{ font-size: 12.5px; line-height: 1.45; color: var(--gris); margin: 0; font-weight: 600; }

  .etapa-flecha{ position: absolute; top: 68px; right: -18px; width: 16px; height: 16px; color: var(--naranja); opacity: 0.55; z-index: 2; }
  .etapa-flecha svg{ width: 100%; height: 100%; }

  .componentes-franja{ background: var(--negro); border-radius: 20px; padding: 28px 30px; text-align: center; max-width: 1080px; margin: 0 auto; }
  .componentes-titulo{ display: block; font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--naranja); margin-bottom: 18px; }
  .componentes-fila{ display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .componente-chip{ font-size: 12.5px; font-weight: 600; color: #fff; background: rgba(251,242,226,0.08); border-radius: 20px; padding: 8px 16px; }

  @media (max-width: 1000px){
    .linea-tiempo{ flex-wrap: wrap; gap: 18px 0; }
    .linea-conectora{ display: none; }
    .etapa-card{ flex: 1 1 40%; min-width: 220px; margin-bottom: 4px; }
    .etapa-flecha{ display: none; }
    .etapa-card.etapa-protagonista{ flex: 1 1 100%; margin-top: 0; margin-bottom: 4px; }
  }

  @media (max-width: 760px){
    .bresumen{ padding: 46px 0; }
    .bresumen-encabezado{ margin-bottom: 36px; }
    .bresumen-encabezado h2{ font-size: 24px; }
    .subtitulo{ font-size: 14px; }
    .linea-tiempo{ flex-direction: column; gap: 14px; margin-bottom: 36px; }
    .etapa-card{ flex: none; margin: 0; text-align: left; display: flex; flex-direction: column; }
    .etapa-card.etapa-protagonista{ align-self: stretch; padding: 22px 18px 24px; }
    .etapa-card.etapa-protagonista .etapa-icono{ width: 52px; height: 52px; }
    .etapa-card.etapa-protagonista .etapa-icono svg{ width: 26px; height: 26px; }
    .etapa-card.etapa-protagonista h3{ font-size: 14.5px; }
    .etapa-icono{ margin: 0 0 12px; }
    .componentes-franja{ padding: 24px 20px; }
  }
</style>
