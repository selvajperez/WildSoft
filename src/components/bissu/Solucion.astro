<section class="bsection bsection-crema" id="solucion">
  <div class="wrap">
    <div class="kicker">Solución propuesta</div>
    <p class="parrafo-central">Se propuso un ecosistema digital integrado —sitio institucional, tienda online y canal de YouTube— que acompañara la reconversión de Bissú desde la venta tradicional por catálogo hacia nuevos canales de comunicación y comercialización, manteniendo su identidad visual y dando protagonismo a productos, colores y colecciones.</p>

    <div class="mock-grid">
      <div class="mock-card">
        <div class="mock-frame browser">
          <div class="mock-bar"><span></span><span></span><span></span></div>
          <svg viewBox="0 0 300 190" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Recreación editorial de un sitio institucional">
            <rect x="0" y="0" width="300" height="190" fill="#FDEEDB" />
            <rect x="0" y="0" width="300" height="26" fill="#151612" opacity="0.85" />
            <circle cx="18" cy="13" r="5" fill="#EC7323" />
            <rect x="200" y="7" width="24" height="12" rx="2" fill="#FBF2E2" opacity="0.7" />
            <rect x="230" y="7" width="24" height="12" rx="2" fill="#FBF2E2" opacity="0.7" />
            <rect x="260" y="7" width="26" height="12" rx="2" fill="#FBF2E2" opacity="0.7" />
            <rect x="18" y="42" width="170" height="16" rx="2" fill="#151612" opacity="0.7" />
            <rect x="18" y="64" width="120" height="10" rx="2" fill="#151612" opacity="0.35" />
            <circle cx="245" cy="60" r="34" fill="#C97B84" opacity="0.85" />
            <circle cx="270" cy="90" r="18" fill="#C9A227" opacity="0.7" />
            <rect x="18" y="100" width="70" height="70" rx="4" fill="#6B3F52" opacity="0.15" stroke="#6B3F52" stroke-width="1" />
            <rect x="98" y="100" width="70" height="70" rx="4" fill="#C97B84" opacity="0.15" stroke="#C97B84" stroke-width="1" />
            <rect x="178" y="100" width="70" height="70" rx="4" fill="#C9A227" opacity="0.15" stroke="#C9A227" stroke-width="1" />
          </svg>
        </div>
        <h3>Sitio institucional</h3>
        <p>Joomla — recreación editorial</p>
      </div>

      <div class="mock-card">
        <div class="mock-frame browser">
          <div class="mock-bar"><span></span><span></span><span></span></div>
          <svg viewBox="0 0 300 190" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Recreación editorial de una tienda online">
            <rect x="0" y="0" width="300" height="190" fill="#FBF2E2" />
            <rect x="0" y="0" width="300" height="26" fill="#151612" opacity="0.85" />
            <rect x="18" y="7" width="60" height="12" rx="2" fill="#FBF2E2" opacity="0.7" />
            <rect x="255" y="6" width="28" height="14" rx="7" fill="#EC7323" />
            <g fill="none" stroke="#151612" stroke-width="1.4" opacity="0.7">
              <rect x="18" y="42" width="60" height="60" rx="3" />
              <rect x="88" y="42" width="60" height="60" rx="3" />
              <rect x="158" y="42" width="60" height="60" rx="3" />
              <rect x="228" y="42" width="60" height="60" rx="3" />
            </g>
            <circle cx="48" cy="72" r="14" fill="#C97B84" />
            <circle cx="118" cy="72" r="14" fill="#6B3F52" />
            <circle cx="188" cy="72" r="14" fill="#C9A227" />
            <circle cx="258" cy="72" r="14" fill="#71781A" opacity="0.8" />
            <rect x="18" y="110" width="50" height="8" rx="2" fill="#151612" opacity="0.35" />
            <rect x="88" y="110" width="50" height="8" rx="2" fill="#151612" opacity="0.35" />
            <rect x="158" y="110" width="50" height="8" rx="2" fill="#151612" opacity="0.35" />
            <rect x="228" y="110" width="50" height="8" rx="2" fill="#151612" opacity="0.35" />
            <rect x="18" y="140" width="264" height="30" rx="15" fill="#151612" opacity="0.9" />
            <text x="150" y="160" font-family="JetBrains Mono, monospace" font-size="10" fill="#FBF2E2" text-anchor="middle">AGREGAR AL CARRITO</text>
          </svg>
        </div>
        <h3>Tienda online</h3>
        <p>PrestaShop — recreación editorial</p>
      </div>

      <div class="mock-card">
        <div class="mock-frame video">
          <svg viewBox="0 0 300 190" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Recreación editorial de un canal de contenidos audiovisuales">
            <rect x="0" y="0" width="300" height="190" fill="#151612" />
            <circle cx="150" cy="82" r="30" fill="#FBF2E2" opacity="0.12" />
            <path d="M140 66 L168 82 L140 98 Z" fill="#EC7323" />
            <g opacity="0.85">
              <rect x="14" y="140" width="60" height="34" rx="3" fill="#C97B84" opacity="0.5" />
              <rect x="82" y="140" width="60" height="34" rx="3" fill="#6B3F52" opacity="0.5" />
              <rect x="150" y="140" width="60" height="34" rx="3" fill="#C9A227" opacity="0.5" />
              <rect x="218" y="140" width="68" height="34" rx="3" fill="#71781A" opacity="0.5" />
            </g>
          </svg>
        </div>
        <h3>Canal de contenidos</h3>
        <p>YouTube — recreación editorial</p>
      </div>
    </div>
  </div>
</section>

<style>
  .bsection-crema{ background: var(--crema); }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 22px; text-align: center; }
  .parrafo-central{ font-size: 17px; line-height: 1.7; color: var(--gris); max-width: 760px; margin: 0 auto 50px; text-align: center; }

  .mock-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; max-width: 1080px; margin: 0 auto; }
  .mock-card{ text-align: center; }
  .mock-frame{ background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 20px 40px -22px rgba(21,22,18,0.35); border: 1px solid rgba(21,22,18,0.08); margin-bottom: 16px; }
  .mock-bar{ display: flex; gap: 6px; padding: 9px 12px; background: #EDEAE2; }
  .mock-bar span{ width: 9px; height: 9px; border-radius: 50%; background: rgba(21,22,18,0.18); display: block; }
  .mock-frame svg{ width: 100%; display: block; }
  .mock-card h3{ font-size: 16px; font-weight: 700; color: var(--negro); margin: 0 0 4px; }
  .mock-card p{ font-size: 12.5px; color: var(--gris); opacity: 0.75; margin: 0; font-style: italic; }

  @media (max-width: 760px){
    .parrafo-central{ font-size: 15px; margin-bottom: 32px; }
    .mock-grid{ grid-template-columns: 1fr; gap: 26px; }
  }
</style>
