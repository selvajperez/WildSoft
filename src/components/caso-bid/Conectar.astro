---
const bloques = [
  {
    titulo: 'Personas',
    texto: 'Sponsor: Alfredo Villaggi · Jefe de Desarrollo: Selva J. Pérez · Jefa de Proyecto: Marina A. Rosas — según el Acta de Alcance del Proyecto.',
  },
  {
    titulo: 'Procesos',
    texto: 'Circuito administrativo y normativo existente entre áreas, a relevar y rediseñar antes de definir cualquier solución técnica.',
  },
  {
    titulo: 'Información',
    texto: 'Publicaciones mensuales del INDEC (PDF) → conversión a Excel → normalización y controles → base histórica → preparación para carga en SQL.',
  },
];
---
<section class="cconectar" id="conectar">
  <div class="wrap">
    <div class="kicker">2 · Conectar</div>
    <p class="quote">&ldquo;Conectar procesos, usuarios y tecnología.&rdquo;</p>

    <div class="bloques">
      {bloques.map((b) => (
        <div class="bloque">
          <h3>{b.titulo}</h3>
          <p>{b.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .cconectar{ background: var(--fondo-claro); padding: 70px 0; }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--naranja); text-align: center; margin-bottom: 26px; }
  .quote{ font-family: var(--font-secundaria); font-style: italic; font-size: 28px; line-height: 1.45; color: var(--negro); text-align: center; max-width: 780px; margin: 0 auto 50px; }

  .bloques{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; max-width: 1100px; margin: 0 auto; }
  .bloque{ background: #fff; border-radius: 14px; padding: 26px 24px; }
  .bloque h3{ font-size: 17px; font-weight: 800; margin: 0 0 10px; color: var(--negro); }
  .bloque p{ font-size: 13.5px; line-height: 1.65; color: var(--gris); margin: 0; }

  @media (max-width: 760px){
    .cconectar{ padding: 44px 0; }
    .quote{ font-size: 21px; margin-bottom: 30px; }
    .bloques{ display: flex; flex-direction: column; gap: 16px; }
    .bloque{ padding: 20px 20px; border-radius: 12px; }
    .bloque h3{ font-size: 16px; }
    .bloque p{ font-size: 13px; }
  }
</style>
