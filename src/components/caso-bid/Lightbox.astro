<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Ampliación de evidencia">
  <button class="lightbox-close" id="lightbox-close" aria-label="Cerrar">&times;</button>
  <div class="lightbox-inner" id="lightbox-inner"></div>
</div>

<style is:global>
  .lightbox{
    position: fixed; inset: 0; z-index: 100; background: rgba(21,22,18,0.94);
    display: none; align-items: center; justify-content: center; padding: 40px 24px;
  }
  .lightbox.open{ display: flex; }
  .lightbox-close{
    position: absolute; top: 20px; right: 28px; background: none; border: none;
    color: var(--crema); font-size: 34px; line-height: 1; cursor: pointer; font-family: var(--font-principal);
  }
  .lightbox-inner{ max-width: 1100px; max-height: 88vh; overflow: auto; }
  .lightbox-inner img{ max-width: 100%; max-height: 88vh; margin: 0 auto; border-radius: 8px; }
  .lightbox-inner .doc-facsimile{ max-width: 720px; margin: 0 auto; }

  [data-lightbox]{ cursor: zoom-in; }

  @media (max-width: 760px){
    .lightbox{ padding: 70px 16px 24px; }
    .lightbox-close{ top: 14px; right: 16px; font-size: 28px; }
  }
</style>

<script>
  function initLightbox() {
    const lightbox = document.getElementById('lightbox');
    const inner = document.getElementById('lightbox-inner');
    if (!lightbox || !inner) return;

    document.addEventListener('click', (e) => {
      const target = e.target;
      const trigger = target.closest('[data-lightbox]');
      if (trigger) {
        const type = trigger.dataset.lightboxType || 'image';
        if (type === 'content') {
          const tpl = document.getElementById(trigger.dataset.lightbox || '');
          inner.innerHTML = tpl ? tpl.innerHTML : '';
        } else {
          const src = trigger.dataset.lightbox || '';
          const alt = trigger.getAttribute('data-lightbox-alt') || '';
          inner.innerHTML = `<img src="${src}" alt="${alt}">`;
        }
        lightbox.classList.add('open');
        return;
      }
      if (target.closest('#lightbox-close') || target.id === 'lightbox') {
        lightbox.classList.remove('open');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') lightbox.classList.remove('open');
    });
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>
