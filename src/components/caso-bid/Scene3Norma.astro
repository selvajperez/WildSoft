---
const pasos = [
  { titulo: 'Normativa', texto: 'Decretos, resoluciones, fórmulas y condiciones.' },
  { titulo: 'Proceso Admin.', texto: 'Actores, expedientes, documentación, controles y aprobaciones.' },
  { titulo: 'Análisis Funcional', texto: 'Reglas de negocio, casos posibles, estados y requerimientos.' },
  { titulo: 'Modelo Sistema', texto: 'Datos, módulos, circuitos, perfiles y validaciones.' },
  { titulo: 'Solución Digital', texto: 'Seguimiento, cálculo, gestión documental y trazabilidad.' },
];
---
<section class="s3">
  <div class="wrap">
    <div class="kicker">Escena 03 — De la norma al sistema</div>
    <p class="pregunta quote-lg">&ldquo;¿Cómo se transforma un decreto en un sistema que administra miles de expedientes?&rdquo;</p>
    <div class="flow5">
      {pasos.map((p, i) => (
        <>
          <div class="flow5-step">
            <div class="flow5-node"><b>{p.titulo}</b></div>
            <p>{p.texto}</p>
          </div>
          {i < pasos.length - 1 && <div class="flow5-arrow">→</div>}
        </>
      ))}
    </div>
    <p class="pull">&ldquo;El desarrollo comenzó antes del código: comenzó interpretando la normativa, relevando el proceso y convirtiendo cada decisión administrativa en una regla funcional.&rdquo;</p>
  </div>
</section>

<style>
  .s3{ background: var(--negro); color: var(--crema); }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); text-align: center; margin-bottom: 26px; }
  .quote-lg{ font-family: var(--font-secundaria); font-style: italic; line-height: 1.4; }
  .pregunta{ font-size: 36px; color: #fff; text-align: center; max-width: 920px; margin: 0 auto 90px; }
  .flow5{ display: flex; align-items: flex-start; justify-content: center; gap: 0; max-width: 1180px; margin: 0 auto 70px; }
  .flow5-step{ flex: 1; text-align: center; padding: 0 14px; }
  .flow5-arrow{ flex: 0 0 auto; color: var(--verde); font-size: 20px; padding-top: 26px; }
  .flow5-node{ border: 1.5px solid var(--verde); border-radius: 8px; padding: 18px 14px; margin-bottom: 14px; }
  .flow5-node b{ font-size: 14.5px; color: #fff; }
  .flow5-step p{ font-size: 12.5px; line-height: 1.55; color: #B8B29F; margin: 0; }
  .pull{
    font-family: var(--font-secundaria); font-style: italic; font-size: 26px; line-height: 1.55; color: var(--crema);
    border-left: 4px solid var(--naranja); padding: 14px 0 14px 32px; max-width: 720px; margin: 0 auto;
  }

  @media (max-width: 760px){
    .kicker{ margin-bottom: 20px; }
    .pregunta{ font-size: 24px; margin-bottom: 44px; }
    .flow5{ flex-direction: column; gap: 0; margin-bottom: 40px; }
    .flow5-step{ padding: 14px 0; }
    .flow5-arrow{ text-align: center; padding: 0; transform: rotate(90deg); }
    .pull{ font-size: 19px; padding: 10px 0 10px 18px; }
  }
</style>
