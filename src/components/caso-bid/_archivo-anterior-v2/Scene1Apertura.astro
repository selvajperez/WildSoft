<section class="s1" id="apertura">
  <div class="wrap s1-inner">
    <div class="s1-left">
      <div class="kicker">Caso de estudio</div>
      <h1>Modernización del Proceso de Redeterminación de Precios de Contratos de Obra Pública</h1>
      <p class="bajada">Análisis, diseño y desarrollo de un prototipo evolutivo destinado a modernizar el proceso de redeterminación de precios de contratos de obra pública.</p>
      <div class="datos">
        <div><b>Programa</b> <span>PMGM — Préstamo BID N° 1855/OC-AR</span></div>
        <div><b>Organismo</b> <span>Ministerio del Interior, Obras Públicas y Vivienda</span></div>
        <div><b>Período</b> <span>Julio – Noviembre 2016</span></div>
        <div><b>Rol</b> <span>Jefe de Desarrollo / Consultoría técnica</span></div>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href="#problema">Explorar el caso</a>
        <a class="btn btn-secondary" href="#mi-rol">Ver mi rol</a>
      </div>
      <button class="evidencia-link" data-lightbox="tpl-alcance" data-lightbox-type="content">
        Fuente: Acta de Alcance del Proyecto — 12/07/2016 ↗
      </button>
    </div>
    <div class="s1-right">
      <svg viewBox="0 0 560 560" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ilustración editorial técnica: planos, expedientes y arquitectura de sistema">
        <g stroke="#151612" stroke-width="1.2" fill="none" opacity="0.55">
          <rect x="40" y="60" width="220" height="160" />
          <line x1="40" y1="100" x2="260" y2="100" />
          <line x1="120" y1="60" x2="120" y2="220" />
          <line x1="190" y1="60" x2="190" y2="220" />
          <line x1="40" y1="160" x2="260" y2="160" />
        </g>
        <g stroke="#71781A" stroke-width="1.4" fill="none">
          <circle cx="150" cy="140" r="6" />
          <circle cx="150" cy="140" r="14" opacity="0.5" />
        </g>
        <g stroke="#151612" stroke-width="1.3" fill="none" opacity="0.7">
          <rect x="330" y="80" width="150" height="105" rx="4" transform="rotate(-4 405 132)"/>
          <rect x="345" y="95" width="150" height="105" rx="4" transform="rotate(3 420 147)"/>
          <line x1="365" y1="120" x2="470" y2="120" transform="rotate(3 420 147)"/>
          <line x1="365" y1="140" x2="450" y2="140" transform="rotate(3 420 147)"/>
        </g>
        <g stroke="#EC7323" stroke-width="1.6" fill="none">
          <path d="M 260 150 C 320 200, 340 260, 300 310" />
          <path d="M 405 190 C 380 250, 360 280, 320 310" />
          <circle cx="300" cy="330" r="10" fill="#EC7323" stroke="none"/>
        </g>
        <g stroke="#151612" stroke-width="1.2" fill="none" opacity="0.7">
          <circle cx="300" cy="330" r="46" />
          <line x1="300" y1="376" x2="180" y2="460" />
          <line x1="300" y1="376" x2="300" y2="480" />
          <line x1="300" y1="376" x2="430" y2="460" />
          <rect x="130" y="460" width="100" height="60" rx="4" />
          <rect x="250" y="480" width="100" height="60" rx="4" />
          <rect x="380" y="460" width="100" height="60" rx="4" />
        </g>
        <g font-family="JetBrains Mono, monospace" font-size="10" fill="#302F2E" opacity="0.6">
          <text x="45" y="55">PLANO — OBRA</text>
          <text x="335" y="75">EXPEDIENTES</text>
          <text x="160" y="500">SISTEMA</text>
        </g>
      </svg>
    </div>
  </div>
</section>

<!-- Facsimil real: Acta de Alcance del Proyecto (hitos + involucrados) -->
<template id="tpl-alcance">
  <div class="doc-facsimile">
    <div class="doc-head">
      <span class="doc-kicker">Documento fuente</span>
      <h3>Acta de Alcance del Proyecto</h3>
      <p class="doc-meta">Modernización del Proceso de Redeterminación de Precios de Contratos de Obra Pública — 12/07/2016</p>
    </div>
    <h4>Hitos del Proyecto</h4>
    <table class="doc-table">
      <tbody>
        <tr><td>Inicio Proyecto</td><td>01/07/2016</td></tr>
        <tr><td>Informe Inicial</td><td>21/07/2016</td></tr>
        <tr><td>Primer Informe de Avance</td><td>30/09/2016</td></tr>
        <tr><td>Segundo Informe de Avance</td><td>31/10/2016</td></tr>
        <tr><td>Final del Proyecto</td><td>30/11/2016</td></tr>
      </tbody>
    </table>
    <h4>Involucrados del Proyecto</h4>
    <table class="doc-table">
      <tbody>
        <tr><td>Sponsor</td><td>Alfredo Villaggi</td></tr>
        <tr class="highlight"><td>Jefe de Desarrollo</td><td>Selva J. Pérez</td></tr>
        <tr><td>Jefa de Proyecto</td><td>Marina A. Rosas</td></tr>
      </tbody>
    </table>
  </div>
</template>

<style>
  .s1{ min-height: 900px; display: flex; align-items: center; padding: 60px; }
  .s1-inner{ display: flex; align-items: center; gap: 70px; width: 100%; padding: 0; }
  .s1-left{ flex: 0 0 42%; }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 24px; }
  .s1-left h1{ font-size: 44px; font-weight: 800; line-height: 1.16; color: var(--negro); margin: 0 0 22px; }
  .bajada{ font-size: 17px; line-height: 1.65; color: var(--gris); margin: 0 0 30px; max-width: 480px; }
  .datos{ margin-bottom: 24px; }
  .datos div{ display: flex; gap: 10px; font-size: 14px; padding: 11px 0; border-top: 1px solid rgba(21,22,18,0.12); color: var(--gris); }
  .datos div:first-child{ border-top: none; }
  .datos b{ color: var(--negro); font-weight: 700; min-width: 100px; flex: 0 0 100px; }
  .btn-row{ display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 22px; }
  .s1-right{ flex: 1; }

  .evidencia-link{
    background: none; border: none; padding: 0; cursor: zoom-in;
    font-size: 13px; font-weight: 600; color: var(--verde); border-bottom: 1px solid var(--verde);
    font-family: var(--font-principal);
  }

  /* Facsimil de documento (reutilizado por Lightbox) */
  .doc-facsimile{ background: var(--crema); border-radius: 12px; padding: 34px 38px; text-align: left; }
  .doc-kicker{ font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--verde); }
  .doc-facsimile h3{ font-size: 20px; font-weight: 800; color: var(--negro); margin: 8px 0 4px; }
  .doc-meta{ font-size: 12.5px; color: var(--gris); margin: 0 0 22px; }
  .doc-facsimile h4{ font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--gris); margin: 22px 0 10px; }
  .doc-table{ width: 100%; border-collapse: collapse; font-size: 14px; }
  .doc-table td{ padding: 9px 4px; border-top: 1px solid rgba(21,22,18,0.12); color: var(--gris); }
  .doc-table tr:first-child td{ border-top: none; }
  .doc-table td:last-child{ text-align: right; color: var(--negro); font-weight: 600; }
  .doc-table tr.highlight td{ color: var(--naranja); font-weight: 700; }

  @media (max-width: 760px){
    .s1{ min-height: auto; padding: 36px 24px 50px; align-items: flex-start; }
    .s1-inner{ flex-direction: column; gap: 0; }
    .s1-left{ flex: none; }
    .kicker{ margin-bottom: 18px; }
    .s1-left h1{ font-size: 27px; line-height: 1.2; margin-bottom: 16px; }
    .bajada{ font-size: 15px; margin-bottom: 24px; max-width: none; }
    .datos{ margin-bottom: 20px; }
    .datos div{ flex-direction: column; gap: 2px; font-size: 13.5px; }
    .datos b{ min-width: 0; flex: none; }
    .btn-row{ flex-direction: column; align-items: stretch; gap: 12px; margin-bottom: 20px; width: 100%; }
    .s1-right{ width: 100%; margin-top: 10px; }
    .doc-facsimile{ padding: 24px 22px; }
  }
</style>
