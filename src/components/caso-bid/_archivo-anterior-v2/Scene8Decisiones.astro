---
const alternativas = ['Nuxeo', 'Abox', 'LogicalDoc', 'NavegaDoc'];
const capas = [
  { titulo: 'Capa web', items: ['Alfresco Share', 'Aplicación web personalizada', 'Interfaces de usuario'] },
  { titulo: 'Capa de contenidos', items: ['Repositorio documental', 'Índices (Lucene)', 'Servicios y workflows'] },
  { titulo: 'Capa de almacenamiento', items: ['Base de datos MySQL', 'Almacén de contenidos', 'Respaldos e índices'] },
];
const ambientes = [
  { n: 'Desarrollo', estado: 'Alcanzado', ok: true },
  { n: 'Integración', estado: 'Contemplado', ok: false },
  { n: 'Testing', estado: 'Alcanzado', ok: true },
  { n: 'Producción', estado: 'Fuera de alcance de esta etapa', ok: false },
];
---
<section class="s7">
  <div class="wrap">
    <div class="s7-head">
      <div class="kicker">Escena 08 — Decisiones técnicas</div>
      <p class="quote-lg">&ldquo;La solución tuvo criterios de selección, arquitectura y ambientes definidos.&rdquo;</p>
    </div>

    <h3 class="sub-head">Evaluación de gestores documentales</h3>
    <div class="comparador">
      {alternativas.map((a) => <span class="alt">{a}</span>)}
      <span class="alt destacado">Alfresco Community — seleccionado</span>
    </div>
    <p class="motivo">Empate técnico entre Alfresco y LogicalDoc. Se eligió Alfresco porque incluía la notificación a usuarios requerida por la operatoria.</p>

    <h3 class="sub-head">Arquitectura en 3 capas</h3>
    <div class="capas">
      {capas.map((c) => (
        <div class="capa">
          <h4>{c.titulo}</h4>
          <ul>{c.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>

    <h3 class="sub-head">Ambientes de trabajo</h3>
    <div class="ambientes">
      {ambientes.map((a, i) => (
        <>
          <div class={`ambiente ${a.ok ? 'ok' : 'no-ok'}`}>
            <div class="ambiente-nombre">{a.n}</div>
            <div class="ambiente-estado">{a.ok ? '✓ ' : ''}{a.estado}</div>
          </div>
          {i < ambientes.length - 1 && <div class="ambiente-arrow">→</div>}
        </>
      ))}
    </div>
    <p class="nota-alcance">El proyecto llegó hasta el ambiente de testing. El pasaje a producción quedó fuera de esta etapa contractual.</p>
  </div>
</section>

<style>
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--naranja); margin-bottom: 20px; }
  .quote-lg{ font-family: var(--font-secundaria); font-style: italic; font-size: 30px; line-height: 1.4; }
  .s7-head{ text-align: center; max-width: 780px; margin: 0 auto 60px; }
  .sub-head{ text-align: center; font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--gris); opacity: 0.75; margin: 0 0 22px; }

  .comparador{ display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; max-width: 800px; margin: 0 auto 16px; }
  .alt{ font-size: 13.5px; padding: 10px 18px; border: 1px solid rgba(21,22,18,0.15); border-radius: 20px; color: var(--gris); }
  .alt.destacado{ background: var(--naranja); border-color: var(--naranja); color: #fff; font-weight: 700; }
  .motivo{ text-align: center; font-size: 14px; color: var(--gris); max-width: 640px; margin: 0 auto 60px; }

  .capas{ display: flex; gap: 20px; max-width: 1000px; margin: 0 auto 60px; }
  .capa{ flex: 1; background: var(--crema); border-radius: 14px; padding: 22px 20px; }
  .capa h4{ font-size: 15px; font-weight: 700; margin: 0 0 12px; color: var(--negro); }
  .capa ul{ margin: 0; padding-left: 16px; }
  .capa li{ font-size: 13px; line-height: 1.6; color: var(--gris); }

  .ambientes{ display: flex; align-items: center; justify-content: center; gap: 0; max-width: 1000px; margin: 0 auto 20px; }
  .ambiente{ flex: 1; text-align: center; padding: 20px 14px; border-radius: 12px; border: 1.5px solid rgba(21,22,18,0.12); }
  .ambiente.ok{ border-color: var(--verde); background: rgba(114,120,26,0.06); }
  .ambiente-nombre{ font-size: 14.5px; font-weight: 700; color: var(--negro); margin-bottom: 6px; }
  .ambiente-estado{ font-size: 12px; color: var(--gris); }
  .ambiente.ok .ambiente-estado{ color: var(--verde); font-weight: 700; }
  .ambiente-arrow{ flex: 0 0 auto; color: var(--gris); opacity: 0.4; font-size: 16px; padding: 0 6px; }
  .nota-alcance{ text-align: center; font-size: 13.5px; color: var(--gris); font-style: italic; max-width: 640px; margin: 0 auto; }

  @media (max-width: 760px){
    .s7-head{ margin-bottom: 36px; }
    .quote-lg{ font-size: 21px; }
    .sub-head{ font-size: 13px; margin-bottom: 18px; }
    .comparador{ margin-bottom: 14px; }
    .motivo{ font-size: 13.5px; margin-bottom: 40px; }
    .capas{ flex-direction: column; gap: 14px; margin-bottom: 40px; }
    .ambientes{ flex-direction: column; gap: 10px; }
    .ambiente{ width: 100%; }
    .ambiente-arrow{ transform: rotate(90deg); padding: 2px 0; }
  }
</style>
