---
const modulos = [
  { idx: 'MÓD. 01', nombre: 'Gestión de expedientes', left: 450, top: 70 },
  { idx: 'MÓD. 02', nombre: 'Gestión documental', left: 739, top: 149 },
  { idx: 'MÓD. 03', nombre: 'Motor de reglas y cálculo', left: 811, top: 327 },
  { idx: 'MÓD. 04', nombre: 'Circuito de estados y aprobaciones', left: 611, top: 469 },
  { idx: 'MÓD. 05', nombre: 'Usuarios, perfiles y permisos', left: 290, top: 469 },
  { idx: 'MÓD. 06', nombre: 'Alertas y seguimiento', left: 89, top: 327 },
  { idx: 'MÓD. 07', nombre: 'Reportes y trazabilidad', left: 161, top: 149 },
];
---
<section class="s6">
  <div class="wrap">
    <div class="s6-head">
      <div class="kicker">Escena 06 — Diseñar la arquitectura</div>
      <p class="quote-lg">&ldquo;Las reglas ya estaban definidas. Ahora había que convertirlas en una solución organizada, escalable y comprensible.&rdquo;</p>
    </div>

    <div class="arch-wrap">
      <svg class="arch-svg" viewBox="0 0 940 600" xmlns="http://www.w3.org/2000/svg">
        <g stroke="rgba(114,120,26,0.55)" stroke-width="1.2" fill="none">
          {modulos.map((m) => <line x1="450" y1="280" x2={m.left} y2={m.top} />)}
        </g>
      </svg>
      <div class="arch-center"><div class="ring"></div><b>Expediente de<br>redeterminación</b></div>
      {modulos.map((m) => (
        <div class="arch-node" style={`left:${m.left}px; top:${m.top}px;`}>
          <div class="idx">{m.idx}</div>
          <div class="box"><b>{m.nombre}</b></div>
        </div>
      ))}
    </div>

    <div class="arch-mobile">
      <div class="arch-center-m"><div class="ring"></div><b>Expediente de<br>redeterminación</b></div>
      <div class="arch-spine">
        {modulos.map((m) => (
          <div class="arch-node-m">
            <div class="idx">{m.idx}</div>
            <div class="box"><b>{m.nombre}</b></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .s6{ background: var(--negro); color: var(--crema); position: relative; overflow: hidden; }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); text-align: center; margin-bottom: 26px; }
  .quote-lg{ font-family: var(--font-secundaria); font-style: italic; line-height: 1.4; font-size: 32px; color: #fff; }
  .s6-head{ text-align: center; max-width: 820px; margin: 0 auto 30px; position: relative; z-index: 2; }

  .arch-wrap{ position: relative; width: 940px; height: 600px; margin: 40px auto 0; }
  .arch-center{
    position: absolute; top: 280px; left: 450px; transform: translate(-50%,-50%);
    width: 180px; height: 180px; border-radius: 50%; border: 2px solid var(--naranja);
    display: flex; align-items: center; justify-content: center; text-align: center;
    background: rgba(236,115,35,0.08); z-index: 3;
  }
  .arch-center b{ font-size: 15px; line-height: 1.3; color: #fff; }
  .arch-center .ring{ position: absolute; inset: -22px; border: 1px solid rgba(236,115,35,0.35); border-radius: 50%; }
  .arch-node{ position: absolute; width: 172px; transform: translate(-50%,-50%); text-align: center; z-index: 3; }
  .arch-node .idx{ font-family: var(--font-mono); font-size: 10.5px; color: var(--verde); margin-bottom: 6px; }
  .arch-node .box{ border: 1px solid rgba(251,242,226,0.25); border-radius: 8px; padding: 12px 10px; background: rgba(251,242,226,0.03); }
  .arch-node .box b{ font-size: 12.5px; color: var(--crema); line-height: 1.3; }
  .arch-svg{ position: absolute; inset: 0; z-index: 1; }

  .arch-mobile{ display: none; }
  .arch-center-m{
    width: 180px; height: 180px; border-radius: 50%; border: 2px solid var(--naranja);
    display: flex; align-items: center; justify-content: center; text-align: center;
    background: rgba(236,115,35,0.08); margin: 0 auto 30px; position: relative;
  }
  .arch-center-m .ring{ position: absolute; inset: -16px; border: 1px solid rgba(236,115,35,0.35); border-radius: 50%; }
  .arch-center-m b{ font-size: 15px; color: #fff; }
  .arch-spine{ position: relative; padding-left: 26px; }
  .arch-spine::before{ content: ''; position: absolute; left: 9px; top: 0; bottom: 0; width: 1px; background: rgba(114,120,26,0.5); }
  .arch-node-m{ position: relative; margin-bottom: 20px; }
  .arch-node-m::before{ content: ''; position: absolute; left: -26px; top: 16px; width: 16px; height: 1px; background: rgba(114,120,26,0.5); }
  .arch-node-m .idx{ font-family: var(--font-mono); font-size: 10px; color: var(--verde); margin-bottom: 5px; }
  .arch-node-m .box{ border: 1px solid rgba(251,242,226,0.25); border-radius: 8px; padding: 12px 14px; background: rgba(251,242,226,0.03); }
  .arch-node-m .box b{ font-size: 13px; color: var(--crema); }

  @media (max-width: 760px){
    .kicker{ margin-bottom: 18px; }
    .quote-lg{ font-size: 22px; }
    .s6-head{ margin-bottom: 36px; }
    .arch-wrap{ display: none; }
    .arch-mobile{ display: block; }
  }
</style>
