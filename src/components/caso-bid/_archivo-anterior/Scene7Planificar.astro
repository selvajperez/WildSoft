---
const etapas = [
  { titulo: 'Definir', texto: 'Alcance, objetivos y requerimientos base.' },
  { titulo: 'Priorizar', texto: 'Núcleo del problema vs. iteraciones posteriores.' },
  { titulo: 'Coordinar', texto: 'Puente entre usuarios, negocio y equipo técnico.' },
  { titulo: 'Verificar', texto: 'Prototipos, documentación y control funcional.' },
  { titulo: 'Documentar y aprobar', texto: 'Justificación e información para el programa BID.' },
];
---
<section class="s7">
  <div class="wrap">
    <div class="s7-head">
      <div class="kicker">Escena 07</div>
      <p class="quote-lg">&ldquo;Una buena solución no alcanza. También hay que convertirla en un proyecto posible.&rdquo;</p>
    </div>
    <div class="flow5b">
      {etapas.map((e, i) => (
        <>
          <div class="flow5b-step">
            <div class="flow5b-node"><b>{e.titulo}</b></div>
            <p>{e.texto}</p>
          </div>
          {i < etapas.length - 1 && <div class="flow5b-arrow">→</div>}
        </>
      ))}
    </div>
    <p class="pull">&ldquo;Como Jefe de Desarrollo, realicé el seguimiento de avances, coordiné definiciones funcionales, preparé documentación y articulé la comunicación necesaria para la evolución y aprobación del proyecto.&rdquo;</p>
  </div>
</section>

<style>
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--naranja); margin-bottom: 20px; }
  .quote-lg{ font-family: var(--font-secundaria); font-style: italic; font-size: 30px; line-height: 1.4; }
  .s7-head{ text-align: center; max-width: 780px; margin: 0 auto 70px; }
  .flow5b{ display: flex; align-items: flex-start; justify-content: center; gap: 0; max-width: 1180px; margin: 0 auto 60px; }
  .flow5b-step{ flex: 1; text-align: center; padding: 0 14px; }
  .flow5b-arrow{ flex: 0 0 auto; color: var(--naranja); font-size: 20px; padding-top: 26px; }
  .flow5b-node{ border: 1.5px solid rgba(21,22,18,0.15); border-radius: 8px; padding: 18px 14px; margin-bottom: 14px; background: var(--crema); }
  .flow5b-node b{ font-size: 14.5px; }
  .flow5b-step p{ font-size: 12.5px; line-height: 1.55; color: var(--gris); margin: 0; }
  .pull{
    font-family: var(--font-secundaria); font-style: italic; font-size: 26px; line-height: 1.55; color: var(--negro);
    border-left: 4px solid var(--naranja); padding: 14px 0 14px 32px; max-width: 720px; margin: 0 auto;
  }

  @media (max-width: 760px){
    .kicker{ margin-bottom: 16px; }
    .quote-lg{ font-size: 21px; }
    .s7-head{ margin-bottom: 40px; }
    .flow5b{ flex-direction: column; gap: 0; margin-bottom: 40px; }
    .flow5b-step{ padding: 14px 0; }
    .flow5b-arrow{ text-align: center; padding: 0; transform: rotate(90deg); }
    .pull{ font-size: 19px; padding: 10px 0 10px 18px; }
  }
</style>
