<section class="jdescarga" id="descarga">
  <div class="wrap">
    <div class="kicker">Descargar caso de estudio</div>
    <h2>Todo el proceso, documentado.</h2>
    <a class="btn btn-primary" href="/downloads/Caso-de-Estudio-Proyecto-Jardin-Estudio.pdf" download>Descargar Caso de Estudio completo (PDF)</a>
    <p class="frase">Este proyecto forma parte de la Biblioteca de Casos de Estudio WildSoft.</p>
  </div>
</section>

<style>
  .jdescarga{ background: var(--negro); color: var(--crema); text-align: center; }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 18px; }
  .jdescarga h2{ font-size: 32px; font-weight: 800; color: #fff; margin: 0 0 32px; }
  .frase{ font-family: var(--font-secundaria); font-style: italic; font-size: 19px; color: var(--crema); margin: 28px 0 0; }

  @media (max-width: 760px){
    .jdescarga h2{ font-size: 22px; margin-bottom: 24px; }
    .frase{ font-size: 16px; margin-top: 22px; }
    .jdescarga :global(.btn){ display: inline-block; width: 100%; }
  }
</style>
