---
// Vista "Por etapa": qué hace la etapa y qué proyectos del Lab la usan.
import type { Etapa, ProyectoRayuela } from '../../../data/rayuela';

interface Uso {
  proyecto: ProyectoRayuela;
  texto: string;
  ficha: { href: string; texto: string } | null;
}

interface Props {
  etapa: Etapa;
  usos: Uso[];
}

const { etapa, usos } = Astro.props;
---
<article class="panel" data-panel-etapa={etapa.id} hidden>
  <header class="panel-head">
    <p class="panel-kicker">Etapa {String(etapa.numero).padStart(2, '0')} · {etapa.accion}</p>
    <h3>{etapa.nombre}</h3>
    <p class="panel-resumen">{etapa.descripcion}</p>
    <p class="panel-uso">
      {usos.length === 1 ? '1 proyecto la usa' : `${usos.length} proyectos la usan`}
    </p>
  </header>

  {usos.length > 0 ? (
    <ul class="usos">
      {usos.map(({ proyecto, texto, ficha }) => (
        <li class="uso">
          <p class="uso-nombre">{proyecto.nombre}</p>
          <p class="uso-texto">{texto}</p>
          <div class="uso-acciones">
            <button type="button" class="uso-btn" data-ver-recorrido={proyecto.id}>Ver su recorrido</button>
            {ficha && <a class="uso-ficha" href={ficha.href}>{ficha.texto} →</a>}
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="vacio">Por ahora ningún proyecto del laboratorio usa esta etapa.</p>
  )}
</article>

<style>
  .panel{ display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 44px; }
  .panel[hidden]{ display: none; }

  .panel-kicker{
    font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    color: #B9C05A; margin: 0 0 10px;
  }
  .panel h3{ font-size: 26px; font-weight: 800; line-height: 1.2; color: #fff; margin: 0 0 12px; }
  .panel-resumen{ font-size: 15px; line-height: 1.6; color: rgba(251,242,226,0.75); margin: 0 0 18px; }
  .panel-uso{ font-family: var(--font-mono); font-size: 12px; color: rgba(251,242,226,0.55); margin: 0; }

  .usos{ list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .uso{ padding: 16px 18px; border-radius: 12px; background: rgba(251,242,226,0.05); border-left: 3px solid var(--naranja); }
  .uso-nombre{ font-size: 15.5px; font-weight: 800; color: #fff; margin: 0 0 6px; }
  .uso-texto{ font-size: 14px; line-height: 1.55; color: rgba(251,242,226,0.72); margin: 0 0 12px; }
  .uso-acciones{ display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
  .uso-btn{
    font: inherit; font-size: 13px; font-weight: 700; cursor: pointer;
    color: var(--crema); background: transparent;
    border: 1px solid rgba(251,242,226,0.3); border-radius: 20px; padding: 6px 14px;
    transition: border-color 200ms ease;
  }
  .uso-btn:hover{ border-color: var(--crema); }
  .uso-btn:focus-visible, .uso-ficha:focus-visible{ outline: 2px solid var(--naranja); outline-offset: 3px; }
  .uso-ficha{ font-size: 13.5px; font-weight: 700; color: var(--naranja); }
  .uso-ficha:hover{ text-decoration: underline; text-underline-offset: 4px; }
  .vacio{ font-size: 14.5px; color: rgba(251,242,226,0.6); margin: 0; align-self: center; }

  @media (max-width: 900px){
    .panel{ grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 760px){
    .panel h3{ font-size: 21px; }
    .panel-resumen{ font-size: 14.5px; }
    .uso{ padding: 14px 14px; }
    .uso-texto{ font-size: 13.5px; }
  }
</style>
