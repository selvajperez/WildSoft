---
const icons: Record<string, string> = {
  chart: '<rect x="3" y="3" width="18" height="18" rx="2"/><rect x="6.5" y="12" width="2.6" height="6"/><rect x="10.7" y="8" width="2.6" height="10"/><rect x="14.9" y="14" width="2.6" height="4"/>',
  ticket: '<path d="M4 4h16v16l-2-1.5L16 20l-2-1.5L12 20l-2-1.5L8 20l-2-1.5L4 20V4z"/><line x1="7" y1="8" x2="17" y2="8"/><line x1="7" y1="12" x2="17" y2="12"/>',
  card: '<rect x="2" y="6" width="20" height="13" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/><line x1="5.5" y1="15" x2="9.5" y2="15"/>',
  people: '<circle cx="9" cy="8" r="3"/><path d="M3.5 20c0-3.2 2.5-5.8 5.5-5.8s5.5 2.6 5.5 5.8"/><circle cx="17.5" cy="9" r="2.2"/><path d="M15.2 20c.3-2.4 1.9-4.3 3.8-4.8"/>',
  alerta: '<path d="M12 2.5l10 17.5H2z"/><line x1="12" y1="9.5" x2="12" y2="14.5"/><circle cx="12" cy="17" r="1" fill="currentColor" stroke="none"/>',
  dashboard: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M6 13l3-4 2 2 3-5 4 7"/><line x1="8" y1="20" x2="16" y2="20"/><line x1="12" y1="16" x2="12" y2="20"/>',
};

const objetivos = [
  { texto: 'Ventas por categoría y región', icon: 'chart' },
  { texto: 'Ingreso promedio por unidad', icon: 'ticket' },
  { texto: 'Métodos de pago por región', icon: 'card' },
  { texto: 'Concentración de ventas por cliente', icon: 'people' },
  { texto: 'Presión sobre el stock', icon: 'alerta' },
  { texto: 'Dashboard claro e interactivo', icon: 'dashboard' },
];
---
<section class="bsection bsection-crema" id="contexto">
  <div class="wrap">
    <div class="kicker">Contexto y desafío</div>
    <p class="parrafo-central">Los datos de ventas, productos, clientes y métodos de pago estaban dispersos en distintas tablas. El desafío era transformarlos en información clara para decisiones comerciales.</p>
    <div class="obj-grid">
      {objetivos.map((o) => (
        <div class="obj-item">
          <div class="obj-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[o.icon]} /></div>
          <span>{o.texto}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bsection-crema{ background: var(--crema); }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 22px; text-align: center; }
  .parrafo-central{ font-size: 17px; line-height: 1.7; color: var(--gris); max-width: 720px; margin: 0 auto 40px; text-align: center; }
  .obj-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; max-width: 940px; margin: 0 auto; }
  .obj-item{ display: flex; align-items: center; gap: 14px; background: #fff; border-radius: 14px; padding: 18px 20px; border-left: 4px solid var(--naranja); }
  .obj-icono{ flex: 0 0 40px; width: 40px; height: 40px; border-radius: 10px; background: var(--fondo-claro); color: var(--naranja); display: flex; align-items: center; justify-content: center; }
  .obj-icono svg{ width: 21px; height: 21px; }
  .obj-item span{ font-size: 14px; font-weight: 700; color: var(--negro); line-height: 1.35; }

  @media (max-width: 900px){
    .obj-grid{ grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px){
    .parrafo-central{ font-size: 15px; margin-bottom: 26px; }
    .obj-grid{ grid-template-columns: 1fr; gap: 10px; }
    .obj-item{ padding: 14px 16px; }
  }
</style>
