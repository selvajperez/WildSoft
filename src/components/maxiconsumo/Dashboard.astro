---
import fs from 'node:fs';
import path from 'node:path';

const inventarioExtensiones = ['webp', 'png', 'jpg', 'jpeg'];
const inventarioExt = inventarioExtensiones.find((ext) =>
  fs.existsSync(path.resolve(`public/images/maxiconsumo/inventario-clientes.${ext}`))
);

const vistas = [
  {
    titulo: 'Panorama general',
    texto: 'Ventas por categoría y región',
    src: '/images/maxiconsumo/panorama-general.jpg',
    alt: 'Vista Panorama general del dashboard de Maxiconsumo en Power BI',
  },
  {
    titulo: 'Rendimiento comercial',
    texto: 'Ingreso por unidad y métodos de pago',
    src: '/images/maxiconsumo/rendimiento-comercial.jpg',
    alt: 'Vista Rendimiento comercial del dashboard de Maxiconsumo en Power BI',
    imgClass: 'img-rendimiento',
  },
  {
    titulo: 'Inventario y clientes',
    texto: 'Concentración de ventas y presión sobre el stock',
    src: inventarioExt ? `/images/maxiconsumo/inventario-clientes.${inventarioExt}` : null,
    alt: 'Vista Inventario y clientes del dashboard de Maxiconsumo en Power BI',
  },
];
---
<section class="bsection bsection-crema" id="dashboard">
  <div class="wrap">
    <div class="kicker">Las tres vistas del dashboard</div>
    <div class="vistas-grid">
      {vistas.map((v) => (
        v.src ? (
          <button class="vista-card" data-lightbox={v.src} data-lightbox-alt={v.alt}>
            <img class={v.imgClass} src={v.src} alt={v.alt} loading="lazy" />
            <div class="vista-info">
              <h4>{v.titulo}</h4>
              <p>{v.texto}</p>
              <span class="vista-link">Ampliar ↗</span>
            </div>
          </button>
        ) : (
          <div class="vista-card vista-pendiente">
            <div class="pendiente-icono">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 20h8"/><path d="M12 18v2"/><path d="M8 10l3 3 5-5"/></svg>
            </div>
            <div class="vista-info">
              <h4>{v.titulo}</h4>
              <p>{v.texto}</p>
              <span class="vista-link vista-link-pendiente">Captura pendiente de incorporar</span>
            </div>
          </div>
        )
      ))}
    </div>
  </div>
</section>

<style>
  .bsection-crema{ background: var(--crema); }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 30px; text-align: center; }
  .vistas-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; max-width: 1160px; margin: 0 auto; }
  .vista-card{ display: block; width: 100%; padding: 0; border: none; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 40px -26px rgba(21,22,18,0.3); text-align: left; cursor: zoom-in; }
  .vista-card img{ width: 100%; display: block; aspect-ratio: 16/10; object-fit: cover; }
  .vista-card img.img-rendimiento{ aspect-ratio: 2304/791; object-fit: cover; }
  .vista-info{ padding: 18px 20px; }
  .vista-info h4{ font-size: 15px; font-weight: 800; color: var(--negro); margin: 0 0 6px; }
  .vista-info p{ font-size: 12.5px; color: var(--gris); margin: 0 0 10px; line-height: 1.45; }
  .vista-link{ font-size: 12.5px; font-weight: 700; color: var(--naranja); }

  .vista-pendiente{ cursor: default; border: 1.5px dashed rgba(21,22,18,0.2); box-shadow: none; }
  .pendiente-icono{ display: flex; align-items: center; justify-content: center; aspect-ratio: 16/10; color: rgba(21,22,18,0.25); background: var(--fondo-claro); }
  .pendiente-icono svg{ width: 44px; height: 44px; }
  .vista-link-pendiente{ color: var(--gris); opacity: 0.6; font-style: italic; }

  @media (max-width: 1000px){
    .vistas-grid{ grid-template-columns: 1fr; gap: 18px; }
  }
</style>
