---
const pasos = [
  'Revisión de fuentes y comprensión de la estructura de los datos',
  'Limpieza, validación y análisis exploratorio con Python',
  'Integración de las tablas de ventas, productos, clientes y métodos de pago',
  'Definición de indicadores comerciales y de inventario',
  'Construcción y validación de las visualizaciones en Power BI',
];

const vistas = [
  { titulo: 'Panorama general', texto: 'Ventas por categoría y región' },
  { titulo: 'Rendimiento comercial', texto: 'Ingreso por unidad y métodos de pago' },
  { titulo: 'Inventario y clientes', texto: 'Concentración de ventas y presión sobre el stock' },
];
---
<section class="bsection" id="proceso">
  <div class="wrap">
    <div class="kicker">Proceso de trabajo</div>
    <div class="flow">
      {pasos.map((p, i) => (
        <div class="flow-step"><span class="flow-n">{i + 1}</span><span>{p}</span></div>
      ))}
    </div>

    <p class="subhead">El tablero se organizó en tres vistas</p>
    <div class="vistas-grid">
      {vistas.map((v) => (
        <div class="vista-card">
          <h4>{v.titulo}</h4>
          <p>{v.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bsection{ background: #fff; }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 30px; text-align: center; }

  .flow{ display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; max-width: 1000px; margin: 0 auto 46px; }
  .flow-step{ display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--gris); padding: 10px 16px; border: 1px solid rgba(21,22,18,0.15); border-radius: 20px; background: var(--crema); }
  .flow-n{ flex: 0 0 20px; width: 20px; height: 20px; border-radius: 50%; background: var(--naranja); color: #fff; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; }

  .subhead{ text-align: center; font-size: 13px; font-weight: 700; color: var(--negro); text-transform: uppercase; letter-spacing: 0.03em; margin: 0 0 20px; }
  .vistas-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 980px; margin: 0 auto; }
  .vista-card{ background: var(--crema); border-radius: 14px; padding: 22px; text-align: center; }
  .vista-card h4{ font-size: 15px; font-weight: 800; color: var(--negro); margin: 0 0 8px; }
  .vista-card p{ font-size: 13px; color: var(--gris); margin: 0; line-height: 1.5; }

  @media (max-width: 760px){
    .flow{ margin-bottom: 32px; }
    .vistas-grid{ grid-template-columns: 1fr; gap: 12px; }
  }
</style>
