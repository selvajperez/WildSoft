---
const evolucion = ['Tienda individual', 'Template', 'Stock', 'Carga rápida móvil'];
---
<section class="mcaso" id="caso-real">
  <div class="wrap">
    <h2>Caso real: Proyecto Jardín</h2>
    <p class="cuerpo">Proyecto Jardín — implementación del sistema para un estudio paisajístico, adaptado a un modelo de catálogo con disponibilidad sujeta a confirmación.</p>

    <p class="evolucion-label">Evolución del producto</p>
    <div class="evolucion">
      {evolucion.map((e, i) => (
        <>
          <span class="evolucion-item">{e}</span>
          {i < evolucion.length - 1 && <span class="evolucion-arrow" aria-hidden="true">→</span>}
        </>
      ))}
    </div>

    <div class="enlaces">
      <a class="btn-caso" href="https://catalogo.proyectojardin.com.ar" target="_blank" rel="noopener"><span aria-hidden="true">↗</span> Ver caso: Proyecto Jardín Estudio</a>
      <a class="btn-caso" href="https://mute.wildsoft.com.ar" target="_blank" rel="noopener"><span aria-hidden="true">↗</span> Ver demo en vivo</a>
      <a class="btn-caso" href="https://mute.wildsoft.com.ar/admin" target="_blank" rel="noopener"><span aria-hidden="true">↗</span> Ver panel de administración</a>
    </div>

    <div class="otra-impl">
      <p class="otra-impl-kicker">Otra implementación</p>
      <h3>Mali</h3>
      <p class="otra-impl-texto">Segunda implementación de MUTE, con identidad visual, catálogo y configuración propios sobre la misma base tecnológica.</p>
      <a class="btn-caso btn-caso-mini" href="https://mali-tau.vercel.app" target="_blank" rel="noopener"><span aria-hidden="true">↗</span> Ver catálogo de Mali</a>
    </div>
  </div>
</section>

<style>
  .mcaso{ padding: 70px 0; }
  .mcaso h2{ font-size: 28px; font-weight: 800; color: var(--negro); text-align: center; margin: 0 0 18px; }
  .cuerpo{ font-size: 15.5px; line-height: 1.7; color: var(--gris); max-width: 700px; margin: 0 auto 40px; text-align: center; }

  .evolucion-label{ text-align: center; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--gris); opacity: 0.75; margin: 0 0 18px; }
  .evolucion{ display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px; max-width: 800px; margin: 0 auto 44px; }
  .evolucion-item{ font-size: 13.5px; font-weight: 600; color: var(--negro); background: var(--crema); padding: 9px 18px; border-radius: 20px; }
  .evolucion-arrow{ color: var(--naranja); font-size: 16px; }

  .enlaces{ display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
  .btn-caso{
    display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 700; color: var(--negro);
    border: 1px solid var(--naranja); border-radius: 20px; padding: 10px 20px;
  }
  .btn-caso:hover{ background: var(--naranja); color: var(--negro); }

  .otra-impl{
    max-width: 480px; margin: 44px auto 0; padding-top: 28px;
    border-top: 1px solid rgba(21,22,18,0.1); text-align: center;
  }
  .otra-impl-kicker{ font-family: var(--font-mono); font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--gris); opacity: 0.75; margin: 0 0 8px; }
  .otra-impl h3{ font-size: 17px; font-weight: 800; color: var(--negro); margin: 0 0 8px; }
  .otra-impl-texto{ font-size: 13px; line-height: 1.55; color: var(--gris); margin: 0 0 16px; }
  .btn-caso-mini{ font-size: 12.5px; padding: 8px 16px; }

  @media (max-width: 760px){
    .mcaso{ padding: 44px 0; }
    .mcaso h2{ font-size: 22px; }
    .cuerpo{ margin-bottom: 30px; }
    .evolucion{ gap: 8px; justify-content: flex-start; margin-bottom: 32px; }
    .evolucion-item{ font-size: 12.5px; padding: 8px 14px; }
    .enlaces{ flex-direction: column; align-items: stretch; }
    .btn-caso{ justify-content: center; }
    .otra-impl{ margin-top: 32px; padding-top: 22px; }
  }
</style>
