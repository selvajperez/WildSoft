---
const stack = ['Astro', 'TypeScript', 'JavaScript', 'Google Sheets API', 'Cloudinary', 'Vercel', 'Git/GitHub'];
---
<section class="mtech">
  <div class="wrap">
    <h2>Tecnologías</h2>
    <div class="pills">
      {stack.map((t) => <span class="pill">{t}</span>)}
    </div>
  </div>
</section>

<style>
  .mtech{ background: var(--crema); padding: 70px 0; }
  .mtech h2{ font-size: 28px; font-weight: 800; color: var(--negro); text-align: center; margin: 0 0 32px; }
  .pills{ display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; max-width: 900px; margin: 0 auto; }
  .pill{
    font-size: 14px; font-weight: 700; color: var(--negro);
    background: #fff; border: 1px solid rgba(21,22,18,0.12); border-radius: 20px; padding: 11px 20px;
  }

  @media (max-width: 760px){
    .mtech{ padding: 44px 0; }
    .mtech h2{ font-size: 22px; margin-bottom: 22px; }
    .pills{ gap: 8px; justify-content: flex-start; }
    .pill{ font-size: 13px; padding: 9px 16px; }
  }
</style>
