---
<section class="pcierre">
  <div class="wrap">
    <p class="quote">&ldquo;Cada proyecto es un camino propio entre comprender, conectar y construir.&rdquo;</p>
    <div class="btn-row">
      <a class="btn btn-primary" href="/recorrido">Ver Recorrido completo</a>
      <a class="btn btn-secondary" href="/#contacto">Contacto</a>
    </div>
  </div>
</section>

<style>
  .pcierre{ text-align: center; padding: 60px 0 80px; }
  .quote{ font-family: var(--font-secundaria); font-style: italic; font-size: 24px; line-height: 1.5; color: var(--negro); max-width: 680px; margin: 0 auto 34px; }
  .btn-row{ display: flex; align-items: center; justify-content: center; gap: 18px; flex-wrap: wrap; }

  @media (max-width: 760px){
    .pcierre{ padding: 40px 0 56px; }
    .quote{ font-size: 19px; margin-bottom: 26px; }
    .btn-row{ flex-direction: column; align-items: stretch; width: 100%; }
  }
</style>
