---
const arquitecturaItems = ['Diagrama general de integración.', 'PLC Siemens S7-300.', 'Nivel IT / OT.', 'Sensores e instrumentación.'];

const flujo = ['Recepción', 'Código de barras', 'Balanza RS-232', 'Access', 'Pool de plasma', 'Producción'];

const plantas = [
  { nivel: 'Planta Baja', items: ['Administración', 'Expedición'] },
  { nivel: 'Primer Subsuelo', items: ['Producción Farma', 'Depósito', 'Control Calidad', 'Microbiología', 'HPLC', 'Empaque'] },
  { nivel: 'Segundo Subsuelo', items: ['Dirección Técnica', 'Asuntos Regulatorios', 'Hemoderivados', 'Kolpak'] },
];

const tecnologiasAnexo = [
  { cat: 'PLC', tec: 'Siemens S7-300' },
  { cat: 'HMI', tec: 'WinCC' },
  { cat: 'Base de datos', tec: 'Access' },
  { cat: 'Comunicación', tec: 'RS-232' },
  { cat: 'Comunicación', tec: 'RS-485' },
  { cat: 'Protocolo', tec: 'Modbus RTU' },
  { cat: 'Sensores', tec: 'PT100' },
  { cat: 'Instrumentación', tec: '4-20 mA' },
];
---
<section class="banex" id="anexos">
  <div class="wrap">
    <div class="kicker">Anexos</div>

    <div class="anexo">
      <h3>Anexo A — Arquitectura IT / OT</h3>
      <p class="anexo-nota">Diagrama general de integración desarrollado en la sección <a href="#arquitectura">Arquitectura de la solución</a>.</p>
      <ul class="lista-compacta">
        {arquitecturaItems.map((i) => <li>{i}</li>)}
      </ul>
    </div>

    <div class="anexo">
      <h3>Anexo B — Flujo de trazabilidad</h3>
      <div class="flujo-diagrama">
        {flujo.map((paso, i) => (
          <>
            <div class="flujo-nodo">{paso}</div>
            {i < flujo.length - 1 && <div class="flujo-flecha">↓</div>}
          </>
        ))}
      </div>
    </div>

    <div class="anexo">
      <h3>Anexo C — Organización de la planta</h3>
      <div class="planta-diagrama">
        {plantas.map((p) => (
          <div class="planta-nivel">
            <h4>{p.nivel}</h4>
            <ul>
              {p.items.map((it) => <li>{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="anexo">
      <h3>Anexo D — Tecnologías utilizadas</h3>
      <div class="tabla">
        <div class="tabla-head"><span>Categoría</span><span>Tecnología</span></div>
        {tecnologiasAnexo.map((t) => (
          <div class="tabla-row"><span>{t.cat}</span><span>{t.tec}</span></div>
        ))}
      </div>
    </div>

    <div class="anexo anexo-e">
      <h3>Anexo E — Reconstrucción visual</h3>
      <p class="anexo-nota">Las imágenes generadas. Todas las ilustraciones técnicas de este caso —incluidos los diagramas de arquitectura y de flujo— son reconstrucciones explicativas elaboradas para acompañar la lectura, según se detalla en la <a href="#evidencias">nota metodológica</a>.</p>
    </div>
  </div>
</section>

<style>
  .banex{ background: var(--crema); }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 40px; text-align: center; }

  .anexo{ max-width: 760px; margin: 0 auto 46px; }
  .anexo:last-child{ margin-bottom: 0; }
  .anexo h3{ font-size: 17px; font-weight: 800; color: var(--negro); margin: 0 0 16px; text-align: center; }
  .anexo-nota{ font-size: 14px; line-height: 1.6; color: var(--gris); text-align: center; margin: 0 0 16px; }
  .anexo-nota a{ color: var(--verde); font-weight: 700; text-decoration: underline; }

  .lista-compacta{ margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .lista-compacta li{ font-size: 13px; color: var(--gris); padding: 8px 16px; border: 1px solid rgba(21,22,18,0.15); border-radius: 20px; background: #fff; }

  .flujo-diagrama{ display: flex; flex-direction: column; align-items: center; background: #fff; border-radius: 14px; padding: 30px 20px; }
  .flujo-nodo{ font-size: 14px; font-weight: 700; color: var(--negro); background: var(--fondo-claro); border: 1px solid rgba(21,22,18,0.12); border-radius: 20px; padding: 10px 26px; }
  .flujo-flecha{ color: var(--naranja); font-size: 18px; padding: 4px 0; }

  .planta-diagrama{ display: flex; flex-direction: column; gap: 2px; background: #fff; border-radius: 14px; overflow: hidden; }
  .planta-nivel{ padding: 20px 26px; border-top: 1px solid rgba(21,22,18,0.08); }
  .planta-nivel:first-child{ border-top: none; }
  .planta-nivel h4{ font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--naranja); margin: 0 0 10px; }
  .planta-nivel ul{ margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .planta-nivel li{ font-size: 13px; color: var(--negro); background: var(--fondo-claro); border-radius: 16px; padding: 6px 14px; }

  .tabla{ background: #fff; border-radius: 12px; overflow: hidden; }
  .tabla-head, .tabla-row{ display: flex; padding: 12px 20px; }
  .tabla-head{ background: var(--negro); color: var(--crema); font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .tabla-row{ border-top: 1px solid rgba(21,22,18,0.08); font-size: 14px; color: var(--negro); }
  .tabla-head span, .tabla-row span{ flex: 1; }

  @media (max-width: 760px){
    .anexo{ margin-bottom: 34px; }
    .anexo h3{ font-size: 15.5px; }
    .planta-nivel{ padding: 16px 18px; }
    .tabla-head, .tabla-row{ padding: 10px 14px; font-size: 13px; }
  }
</style>
