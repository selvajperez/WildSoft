<section class="v2cierre">
  <div class="wrap">
    <p class="cierre-titulo">¿Querés el detalle completo?</p>
    <a class="btn btn-primary btn-pdf" href="/downloads/Caso-de-Estudio-Purissimus.pdf" download>
      Descargar caso de estudio completo (PDF)
    </a>
    <div class="links-row">
      <a href="/#proyectos">Volver a proyectos</a>
    </div>
  </div>
</section>

<style>
  .v2cierre{ background: var(--negro); color: var(--crema); text-align: center; padding: 70px 0; }
  .cierre-titulo{ font-size: 22px; font-weight: 800; color: #fff; margin: 0 0 26px; }
  .btn-pdf{ box-shadow: 0 14px 30px -12px rgba(236,115,35,0.55); }
  .links-row{ display: flex; justify-content: center; gap: 30px; margin-top: 26px; flex-wrap: wrap; }
  .links-row a{ font-size: 13.5px; color: var(--crema); opacity: 0.75; text-decoration: underline; }

  @media (max-width: 760px){
    .v2cierre{ padding: 46px 0; }
    .cierre-titulo{ font-size: 18px; }
    .links-row{ flex-direction: column; gap: 12px; }
  }
</style>
