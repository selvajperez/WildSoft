---
const metodologia = [
  'Relevamiento de incidencias reportadas por Producción y Hemoderivados.',
  'Diagnóstico de hardware, software, PLC e instrumentación.',
  'Análisis conjunto con Dirección Técnica y Asuntos Regulatorios cuando la incidencia afectaba procesos críticos.',
  'Validación de las intervenciones antes de restablecer la operación.',
];
const niveles = [
  { n: 'Nivel IT', d: 'Sistema de trazabilidad basado en Access, balanzas RS-232 y códigos de barras.' },
  { n: 'Nivel OT', d: 'PLC Siemens S7-300, HMI WinCC y comunicaciones industriales.' },
  { n: 'Nivel de campo', d: 'Sensores, transmisores, válvulas neumáticas, variadores y equipos de proceso.' },
];
const intervenciones = [
  'Diagnóstico de sensores e instrumentación.',
  'Soporte a PLC Siemens S7-300.',
  'Verificación de comunicaciones RS-485 / Modbus RTU.',
  'Integración entre el sistema de trazabilidad y la automatización.',
  'Resolución de incidencias reportadas por Producción.',
];
const areas = ['Producción', 'Hemoderivados', 'Dirección Técnica', 'Asuntos Regulatorios', 'Control de Calidad', 'Área de Sistemas'];
---
<section class="bsection" id="desarrollo">
  <div class="wrap">
    <div class="kicker">Desarrollo</div>
    <p class="parrafo-central">La participación en el área de hemoderivados requirió comprender la interacción entre los sistemas de automatización, la instrumentación de campo y los procesos productivos, brindando soporte técnico para mantener la continuidad operativa de una planta sometida a estrictos estándares de calidad y auditoría.</p>

    <div class="bloque">
      <h3>Metodología de trabajo</h3>
      <div class="flow">
        {metodologia.map((p, i) => (
          <div class="flow-step"><span class="flow-n">{i + 1}</span><span>{p}</span></div>
        ))}
      </div>
    </div>

    <div class="bloque">
      <h3>Arquitectura funcional</h3>
      <p class="parrafo-chica">La solución integraba tres niveles tecnológicos:</p>
      <div class="niveles-grid">
        {niveles.map((n) => (
          <div class="nivel-card">
            <h4>{n.n}</h4>
            <p>{n.d}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="bloque two-col">
      <div class="col">
        <h3>Intervenciones técnicas</h3>
        <ul class="lista">
          {intervenciones.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <div class="col">
        <h3>Trabajo interdisciplinario</h3>
        <p class="parrafo-chica">Las intervenciones se realizaban en coordinación con:</p>
        <div class="chips">
          {areas.map((a) => <span class="chip">{a}</span>)}
        </div>
      </div>
    </div>

    <div class="bloque resultado-op">
      <h3>Resultado operativo</h3>
      <p class="parrafo-chica">La metodología de trabajo permitió mantener la disponibilidad de la infraestructura tecnológica que soportaba el proceso de producción, contribuyendo a la continuidad operativa, la trazabilidad del plasma y el cumplimiento de los procedimientos exigidos por las auditorías.</p>
    </div>
  </div>
</section>

<style>
  .bsection{ background: #fff; }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 22px; text-align: center; }
  .parrafo-central{ font-size: 16.5px; line-height: 1.7; color: var(--gris); max-width: 780px; margin: 0 auto 50px; text-align: center; }

  .bloque{ max-width: 940px; margin: 0 auto 50px; }
  .bloque:last-child{ margin-bottom: 0; }
  .bloque h3{ font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--naranja); margin: 0 0 18px; text-align: center; }
  .parrafo-chica{ font-size: 14.5px; line-height: 1.6; color: var(--gris); text-align: center; margin: 0 0 18px; }

  .flow{ display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .flow-step{ display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--gris); padding: 10px 16px; border: 1px solid rgba(21,22,18,0.15); border-radius: 20px; background: var(--crema); }
  .flow-n{ flex: 0 0 20px; width: 20px; height: 20px; border-radius: 50%; background: var(--naranja); color: #fff; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; }

  .niveles-grid{ display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .nivel-card{ background: var(--crema); border-radius: 12px; padding: 20px; }
  .nivel-card h4{ font-size: 14.5px; font-weight: 700; color: var(--negro); margin: 0 0 8px; }
  .nivel-card p{ font-size: 13.5px; line-height: 1.55; color: var(--gris); margin: 0; }

  .two-col{ display: flex; gap: 50px; }
  .col{ flex: 1; }
  .lista{ margin: 0; padding: 0; list-style: none; }
  .lista li{ font-size: 14px; line-height: 1.55; color: var(--negro); padding: 10px 0 10px 18px; border-top: 1px solid rgba(21,22,18,0.1); position: relative; }
  .lista li:first-child{ border-top: none; }
  .lista li::before{ content: '—'; position: absolute; left: 0; color: var(--naranja); }
  .chips{ display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .chip{ font-size: 12.5px; color: var(--gris); padding: 7px 14px; border: 1px solid rgba(21,22,18,0.15); border-radius: 20px; background: var(--crema); }

  .resultado-op{ background: var(--crema); border-radius: 16px; padding: 30px 34px; }
  .resultado-op h3{ margin-bottom: 12px; }
  .resultado-op p{ margin: 0; }

  @media (max-width: 760px){
    .parrafo-central{ font-size: 14.5px; margin-bottom: 36px; }
    .bloque{ margin-bottom: 36px; }
    .niveles-grid{ grid-template-columns: 1fr; gap: 12px; }
    .two-col{ flex-direction: column; gap: 30px; }
    .resultado-op{ padding: 22px 20px; }
  }
</style>
