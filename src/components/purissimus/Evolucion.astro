---
const etapas = [
  { n: 1, texto: 'Incorporación al área de Sistemas y soporte a la infraestructura informática.' },
  { n: 2, texto: 'Administración de la red corporativa, estaciones de trabajo y sistemas Windows.' },
  { n: 3, texto: 'Participación en la actualización tecnológica de la infraestructura y adecuación para el cambio de milenio (Y2K).' },
  { n: 4, texto: 'Integración con los sistemas de trazabilidad basados en Access, balanzas industriales y códigos de barras.' },
  { n: 5, texto: 'Participación en el soporte a la automatización del área de hemoderivados mediante PLC Siemens S7-300.' },
  { n: 6, texto: 'Trabajo conjunto con Producción, Dirección Técnica y Asuntos Regulatorios en la resolución de incidencias críticas y auditorías.' },
  { n: 7, texto: 'Consolidación de una metodología de trabajo basada en documentación técnica, trazabilidad y continuidad operativa.' },
];
---
<section class="bevol" id="evolucion">
  <div class="wrap">
    <div class="kicker">Evolución del proyecto · 2001–2004</div>
    <div class="timeline">
      {etapas.map((e) => (
        <div class="etapa">
          <div class="etapa-marker"><span class="etapa-dot"></span><span class="etapa-line"></span></div>
          <div class="etapa-body">
            <span class="etapa-n">Etapa {e.n}</span>
            <p>{e.texto}</p>
          </div>
        </div>
      ))}
    </div>
    <p class="nota">Durante el período del proyecto, mi participación evolucionó desde tareas de infraestructura informática hacia el soporte de sistemas de automatización industrial y procesos críticos, incorporando experiencia en integración IT/OT, trazabilidad y trabajo interdisciplinario en un entorno farmacéutico altamente regulado.</p>
  </div>
</section>

<style>
  .bevol{ background: var(--crema); }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 40px; text-align: center; }
  .timeline{ max-width: 720px; margin: 0 auto 34px; }
  .etapa{ display: flex; gap: 20px; }
  .etapa-marker{ flex: 0 0 16px; display: flex; flex-direction: column; align-items: center; }
  .etapa-dot{ width: 14px; height: 14px; border-radius: 50%; background: var(--verde); flex: none; }
  .etapa-line{ flex: 1; width: 2px; background: rgba(21,22,18,0.15); margin: 4px 0; }
  .etapa:last-child .etapa-line{ display: none; }
  .etapa-body{ padding-bottom: 26px; }
  .etapa-n{ font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--naranja); font-weight: 700; }
  .etapa-body p{ font-size: 15px; line-height: 1.55; color: var(--negro); margin: 6px 0 0; }
  .nota{ font-size: 14px; color: var(--gris); text-align: center; max-width: 680px; margin: 0 auto; }

  @media (max-width: 760px){
    .kicker{ margin-bottom: 30px; }
    .etapa-body p{ font-size: 14px; }
    .nota{ font-size: 13.5px; }
  }
</style>
