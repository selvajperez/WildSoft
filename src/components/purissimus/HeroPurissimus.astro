---
<section class="phero" id="purissimus-hero">
  <div class="wrap phero-inner">
    <div class="phero-left">
      <div class="kicker">Caso de estudio · Automatización industrial</div>
      <h1>Purissimus S.A.</h1>
      <p class="bajada">Soporte tecnológico al área de hemoderivados de Laboratorios Purissimus S.A.: automatización industrial, integración IT/OT y trazabilidad en una planta de producción farmacéutica altamente regulada.</p>
      <div class="datos">
        <div><b>Cliente</b> <span>Laboratorios Purissimus S.A.</span></div>
        <div><b>Industria</b> <span>Producción farmacéutica y hemoderivados</span></div>
        <div><b>Servicios</b> <span>Automatización industrial · Integración IT/OT · Trazabilidad</span></div>
        <div><b>Estado</b> <span>Implementado y operativo</span></div>
        <div><b>Período del proyecto</b> <span>2001 – 2004</span></div>
      </div>
      <div class="btn-row">
        <a class="btn btn-primary" href="#contexto">Explorar el caso</a>
        <a class="btn btn-secondary" href="#evidencias">Ver evidencias</a>
      </div>
    </div>
    <div class="phero-right">
      <svg viewBox="0 0 560 560" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ilustración editorial: integración entre sistemas informáticos (IT), automatización industrial (OT) y campo">
        <!-- Nivel IT -->
        <g stroke="#151612" stroke-width="1.2" fill="none" opacity="0.65">
          <rect x="60" y="50" width="440" height="90" rx="6" />
        </g>
        <g stroke="#151612" stroke-width="1.1" fill="none" opacity="0.6">
          <path d="M100 80 a 20 8 0 1 0 40 0 a 20 8 0 1 0 -40 0" />
          <line x1="100" y1="80" x2="100" y2="100" />
          <line x1="140" y1="80" x2="140" y2="100" />
          <path d="M100 100 a 20 8 0 1 0 40 0" />
        </g>
        <g fill="none" stroke="#151612" stroke-width="1" opacity="0.45">
          <line x1="170" y1="75" x2="280" y2="75" />
          <line x1="170" y1="90" x2="260" y2="90" />
          <line x1="170" y1="105" x2="270" y2="105" />
        </g>
        <circle cx="450" cy="95" r="18" fill="#71781A" opacity="0.8" stroke="none" />

        <!-- Conectores IT-OT -->
        <g stroke="#EC7323" stroke-width="1.6" fill="none">
          <line x1="150" y1="140" x2="150" y2="185" />
          <line x1="410" y1="140" x2="410" y2="185" />
        </g>

        <!-- Nivel OT -->
        <g stroke="#151612" stroke-width="1.2" fill="none" opacity="0.65">
          <rect x="60" y="185" width="440" height="110" rx="6" />
        </g>
        <g stroke="#151612" stroke-width="1.3" fill="none" opacity="0.7">
          <rect x="95" y="212" width="90" height="56" rx="3" />
          <line x1="95" y1="228" x2="185" y2="228" />
        </g>
        <g font-family="JetBrains Mono, monospace" font-size="9" fill="#302F2E" opacity="0.7">
          <text x="102" y="224">PLC S7-300</text>
        </g>
        <g stroke="#151612" stroke-width="1.1" fill="none" opacity="0.6">
          <rect x="210" y="212" width="90" height="56" rx="3" />
          <line x1="222" y1="230" x2="288" y2="230" />
          <line x1="222" y1="240" x2="270" y2="240" />
          <line x1="222" y1="250" x2="280" y2="250" />
        </g>
        <g font-family="JetBrains Mono, monospace" font-size="9" fill="#302F2E" opacity="0.6">
          <text x="222" y="224">HMI WinCC</text>
        </g>
        <g stroke="#151612" stroke-width="1" fill="none" opacity="0.55">
          <path d="M330 240 h 40 M340 232 v 16 M360 232 v 16" />
          <circle cx="400" cy="240" r="16" />
          <circle cx="440" cy="240" r="16" />
        </g>

        <!-- Conectores OT-Campo -->
        <g stroke="#EC7323" stroke-width="1.6" fill="none">
          <line x1="150" y1="295" x2="150" y2="340" />
          <line x1="410" y1="295" x2="410" y2="340" />
        </g>

        <!-- Nivel de campo -->
        <g stroke="#151612" stroke-width="1.2" fill="none" opacity="0.65">
          <rect x="60" y="340" width="440" height="100" rx="6" />
        </g>
        <g stroke="#C97B84" stroke-width="1.4" fill="none" opacity="0.85">
          <circle cx="110" cy="390" r="20" />
          <text x="98" y="394" font-family="JetBrains Mono, monospace" font-size="8" fill="#302F2E">PT100</text>
        </g>
        <g stroke="#151612" stroke-width="1.2" fill="none" opacity="0.6">
          <path d="M175 375 l 20 15 l -20 15 l -20 -15 z" />
        </g>
        <g stroke="#151612" stroke-width="1.2" fill="none" opacity="0.6">
          <rect x="230" y="372" width="36" height="36" rx="18" />
          <line x1="248" y1="372" x2="248" y2="364" />
        </g>
        <g stroke="#151612" stroke-width="1.2" fill="none" opacity="0.6">
          <circle cx="330" cy="390" r="18" />
          <circle cx="330" cy="390" r="8" />
        </g>
        <g fill="#71781A" opacity="0.8" stroke="none">
          <rect x="390" y="374" width="70" height="32" rx="4" />
        </g>
        <g font-family="JetBrains Mono, monospace" font-size="9" fill="#FBF2E2" opacity="0.9">
          <text x="400" y="394">TRAZABILIDAD</text>
        </g>

        <g font-family="JetBrains Mono, monospace" font-size="10" fill="#302F2E" opacity="0.6">
          <text x="66" y="66">NIVEL IT</text>
          <text x="66" y="201">NIVEL OT</text>
          <text x="66" y="356">NIVEL DE CAMPO</text>
        </g>
      </svg>
      <p class="ilustracion-nota">Ilustración técnica — reconstrucción explicativa de la arquitectura IT/OT.</p>
    </div>
  </div>
</section>

<style>
  .phero{ background: var(--crema); padding-top: 70px; padding-bottom: 90px; }
  .phero-inner{ display: flex; align-items: center; gap: 64px; }
  .phero-left{ flex: 0 0 44%; }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 22px; }
  .phero-left h1{ font-size: 40px; font-weight: 800; line-height: 1.16; color: var(--negro); margin: 0 0 20px; }
  .bajada{ font-size: 16.5px; line-height: 1.65; color: var(--gris); margin: 0 0 30px; max-width: 480px; }
  .datos{ margin-bottom: 24px; }
  .datos div{ display: flex; gap: 10px; font-size: 13.5px; padding: 11px 0; border-top: 1px solid rgba(21,22,18,0.12); color: var(--gris); }
  .datos div:first-child{ border-top: none; }
  .datos b{ color: var(--negro); font-weight: 700; min-width: 130px; flex: 0 0 130px; }
  .btn-row{ display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }

  .phero-right{ flex: 1; }
  .ilustracion-nota{ font-size: 11.5px; color: var(--gris); opacity: 0.65; text-align: center; margin: 14px 0 0; font-style: italic; }

  @media (max-width: 760px){
    .phero{ padding-top: 40px; padding-bottom: 50px; }
    .phero-inner{ flex-direction: column; gap: 30px; }
    .phero-left{ flex: none; }
    .phero-left h1{ font-size: 27px; line-height: 1.2; margin-bottom: 16px; }
    .bajada{ font-size: 15px; margin-bottom: 24px; max-width: none; }
    .datos div{ flex-direction: column; gap: 2px; font-size: 13px; }
    .datos b{ min-width: 0; flex: none; }
    .btn-row{ flex-direction: column; align-items: stretch; gap: 12px; }
    .phero-right{ width: 100%; }
  }
</style>
