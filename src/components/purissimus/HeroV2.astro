---
import { Image } from 'astro:assets';
import heroPurissimus from '../../assets/purissimus/hero-purissimus.png';

const ficha = [
  { label: 'Cliente', valor: 'Laboratorios Purissimus S.A.' },
  { label: 'Industria', valor: 'Producción farmacéutica y hemoderivados' },
  { label: 'Servicios', valor: 'Automatización industrial · Integración IT/OT · Trazabilidad' },
  { label: 'Estado', valor: 'Implementado y operativo' },
  { label: 'Período del proyecto', valor: '2001 – 2004' },
];
---
<section class="v2hero" id="overview">
  <div class="wrap v2hero-inner">
    <div class="v2hero-left">
      <div class="kicker">Caso de estudio · Automatización industrial</div>
      <h1>Purissimus S.A.</h1>
      <p class="bajada">Comprendé el proyecto de un vistazo: arquitectura, procesos y resultados representados visualmente. El detalle completo está siempre disponible en el PDF.</p>

      <div class="ficha-grid">
        {ficha.map((f) => (
          <div class="ficha-item">
            <span class="ficha-label">{f.label}</span>
            <span class="ficha-valor">{f.valor}</span>
          </div>
        ))}
      </div>

      <div class="btn-row">
        <a class="btn btn-primary btn-pdf" href="/downloads/Caso-de-Estudio-Purissimus.pdf" download>
          Descargar caso de estudio completo (PDF)
        </a>
        <a class="btn btn-secondary" href="#profundizar">Ver el texto completo</a>
      </div>
    </div>
    <div class="v2hero-right">
      <div class="v2hero-media">
        <Image
          src={heroPurissimus}
          alt="Purissimus S.A.: automatización e integración en planta de hemoderivados — del registro manual en papel a un sistema integrado con PLC, HMI y trazabilidad de lote"
          widths={[480, 768, 1100, 1672]}
          sizes="(max-width: 760px) 100vw, 58vw"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<template id="tpl-resumen-visual">
  <div class="resumen-modal">
    <img class="resumen-img" src="/images/purissimus/resumen-visual.jpg" alt="Resumen visual del caso de estudio Purissimus S.A.: el desafío, la solución, la arquitectura IT/OT/campo, las tecnologías y el resultado" />
    <a class="btn btn-primary" href="/downloads/Caso-de-Estudio-Purissimus.pdf" download>Descargar caso de estudio completo (PDF)</a>
  </div>
</template>

<style>
  .v2hero{ background: var(--crema); padding: 56px 0 70px; }
  .v2hero-inner{ display: flex; align-items: flex-start; gap: 56px; }
  .v2hero-left{ flex: 0 0 37%; min-width: 0; text-align: left; }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 14px; }
  .v2hero h1{ font-size: 34px; font-weight: 800; line-height: 1.1; color: var(--negro); margin: 0 0 14px; }
  .bajada{ font-size: 15.5px; line-height: 1.55; color: var(--gris); margin: 0 0 22px; }

  .ficha-grid{ display: grid; grid-template-columns: repeat(auto-fit, minmax(84px, 1fr)); gap: 1px; margin: 0 0 22px; background: rgba(21,22,18,0.08); border-radius: 10px; overflow: hidden; }
  .ficha-item{ background: #fff; padding: 10px 8px; display: flex; flex-direction: column; gap: 4px; text-align: left; min-width: 0; }
  .ficha-label{ font-family: var(--font-mono); font-size: 8px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: var(--naranja); }
  .ficha-valor{ font-size: 10.5px; font-weight: 700; color: var(--negro); line-height: 1.25; overflow-wrap: break-word; }

  .btn-row{ display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .btn-pdf{ box-shadow: 0 14px 30px -12px rgba(236,115,35,0.55); }

  .v2hero-right{ flex: 1; margin-top: 4px; }
  .v2hero-media{ border-radius: 18px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(21,22,18,0.4); }
  .v2hero-media :global(img){ width: 100%; height: auto; display: block; }

  @media (max-width: 760px){
    .v2hero{ padding: 44px 0 50px; }
    .v2hero-inner{ flex-direction: column; gap: 30px; }
    .v2hero-left{ flex: none; }
    .v2hero h1{ font-size: 28px; }
    .bajada{ font-size: 15px; margin-bottom: 26px; }
    .ficha-grid{ grid-template-columns: 1fr 1fr; margin-bottom: 26px; }
    .ficha-item{ padding: 14px 12px; }
    .ficha-label{ font-size: 10px; letter-spacing: 0.05em; }
    .ficha-valor{ font-size: 13px; line-height: 1.4; }
    .btn-row{ flex-direction: column; align-items: stretch; width: 100%; }
    .v2hero-right{ width: 100%; margin-top: 0; }
  }

  .resumen-modal{ text-align: center; }
  .resumen-img{ max-height: 70vh !important; border-radius: 10px; }
  .resumen-modal .btn{ margin-top: 22px; }

  @media (max-width: 760px){
    .resumen-img{ max-height: 55vh !important; }
  }
</style>
