---
const indicadores = [
  { n: 'PLC Siemens S7-300', e: 'En operación' },
  { n: 'HMI WinCC', e: 'En operación' },
  { n: 'Sistema de trazabilidad', e: 'En operación' },
  { n: 'Balanza industrial', e: 'Integrada' },
  { n: 'Lectores de código de barras', e: 'Operativos' },
  { n: 'Sensores PT100', e: 'Operativos' },
  { n: 'Instrumentación 4–20 mA', e: 'Operativa' },
  { n: 'Comunicaciones Modbus RTU', e: 'Operativas' },
];
---
<section class="bind" id="indicadores">
  <div class="wrap">
    <div class="kicker">Indicadores del proyecto</div>
    <p class="colhead">Arquitectura implementada</p>
    <div class="ind-table">
      {indicadores.map((i) => (
        <div class="ind-row">
          <span class="ind-nombre">{i.n}</span>
          <span class="ind-badge">{i.e}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .bind{ background: #fff; }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 10px; text-align: center; }
  .colhead{ text-align: center; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--gris); opacity: 0.7; margin: 0 0 24px; }
  .ind-table{ max-width: 760px; margin: 0 auto; }
  .ind-row{ display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 14px 4px; border-top: 1px solid rgba(21,22,18,0.1); }
  .ind-row:first-child{ border-top: none; }
  .ind-nombre{ font-size: 15px; color: var(--negro); font-weight: 600; }
  .ind-badge{ flex: none; font-size: 11.5px; font-weight: 700; padding: 5px 14px; border-radius: 20px; white-space: nowrap; background: rgba(113,120,26,0.15); color: var(--verde); }

  @media (max-width: 760px){
    .ind-row{ flex-direction: column; align-items: flex-start; gap: 8px; padding: 14px 0; }
    .ind-nombre{ font-size: 14px; }
  }
</style>
