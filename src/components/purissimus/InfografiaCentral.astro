---
const icons: Record<string, string> = {
  it: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><line x1="8" y1="20" x2="16" y2="20"/><line x1="12" y1="16" x2="12" y2="20"/>',
  ot: '<rect x="5" y="5" width="14" height="14" rx="1.5"/><line x1="8" y1="9" x2="14" y2="9"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="12" y2="17"/>',
  campo: '<circle cx="12" cy="14" r="7"/><path d="M12 14 L16 9"/><path d="M8 5 h8"/>',
  inbox: '<path d="M3 12h5l1.5 3h5L16 12h5"/><path d="M3 12v6a1 1 0 001 1h16a1 1 0 001-1v-6"/><path d="M6 12L8 5h8l2 7"/>',
  barras: '<line x1="4" y1="5" x2="4" y2="19"/><line x1="7.5" y1="5" x2="7.5" y2="19"/><line x1="10" y1="5" x2="10" y2="19"/><line x1="14" y1="5" x2="14" y2="19"/><line x1="17" y1="5" x2="17" y2="19"/><line x1="20" y1="5" x2="20" y2="19"/>',
  balanza: '<path d="M12 3v18"/><path d="M5 21h14"/><path d="M4 7h7M13 7h7"/><path d="M4 7l-2.5 5a2.5 2.5 0 005 0z"/><path d="M20 7l-2.5 5a2.5 2.5 0 005 0z"/>',
  db: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/>',
  drop: '<path d="M12 3c4 5 6.5 8.3 6.5 11.3A6.5 6.5 0 015.5 14.3C5.5 11.3 8 8 12 3z"/>',
  fabrica: '<path d="M3 21V11l5 3v-3l5 3V8l6 4v9z"/><line x1="3" y1="21" x2="21" y2="21"/>',
  plc: '<rect x="5" y="5" width="14" height="14" rx="1.5"/><line x1="8" y1="9" x2="14" y2="9"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="12" y2="17"/>',
  hmi: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M6 13l3-4 2 2 3-5 4 7"/><line x1="8" y1="20" x2="16" y2="20"/><line x1="12" y1="16" x2="12" y2="20"/>',
  comm: '<circle cx="5" cy="12" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="19" cy="18" r="2"/><path d="M7 12h5"/><path d="M12 12l5-6"/><path d="M12 12l5 6"/>',
  sensor: '<circle cx="12" cy="14" r="7"/><path d="M12 14 L16 9"/><path d="M8 5 h8"/>',
};

const arrowIcon = '<path d="M5 12h13"/><path d="M13 6l6 6-6 6"/>';

const arquitectura = [
  { nivel: 'Nivel IT', items: ['Microsoft Access'], icon: 'it' },
  { nivel: 'Nivel OT', items: ['PLC Siemens S7-300', 'HMI WinCC'], icon: 'ot' },
  { nivel: 'Nivel de campo', items: ['Sensores PT100', 'Transmisores 4–20 mA'], icon: 'campo' },
];

const flujo = [
  { texto: 'Recepción', icon: 'inbox' },
  { texto: 'Código de barras', icon: 'barras' },
  { texto: 'Balanza RS-232', icon: 'balanza' },
  { texto: 'Access', icon: 'db' },
  { texto: 'Pool de plasma', icon: 'drop' },
  { texto: 'Producción', icon: 'fabrica' },
];

const tecnologias = [
  { texto: 'PLC Siemens S7-300', icon: 'plc' },
  { texto: 'HMI WinCC', icon: 'hmi' },
  { texto: 'RS-485 · Modbus RTU', icon: 'comm' },
  { texto: 'Microsoft Access', icon: 'db' },
  { texto: 'PT100 · 4–20 mA', icon: 'sensor' },
];

const tabla = [
  { cat: 'PLC', tec: 'Siemens S7-300' },
  { cat: 'HMI', tec: 'WinCC' },
  { cat: 'Base de datos', tec: 'Access' },
  { cat: 'Comunicación', tec: 'RS-485' },
];
---
<section class="infografia" id="vistazo" aria-label="Diagrama general del proyecto: arquitectura IT/OT, flujo de trazabilidad y tecnologías clave">
  <div class="wrap">
    <span class="mapa-kicker">Mapa Operativo</span>
    <div class="poster">
      <div class="poster-linea" aria-hidden="true"></div>
      <div class="poster-col">
        <span class="col-n">01</span>
        <div class="col-diagrama arquitectura-diagrama">
          {arquitectura.map((n, i) => (
            <>
              <div class="nivel-box">
                <div class="nivel-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[n.icon]} /></div>
                <div class="nivel-texto">
                  <span class="nivel-nombre">{n.nivel}</span>
                  <span class="nivel-items">{n.items.join(' · ')}</span>
                </div>
              </div>
              {i < arquitectura.length - 1 && <div class="conector"></div>}
            </>
          ))}
        </div>
      </div>

      <div class="poster-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={arrowIcon} />
      </div>

      <div class="poster-col">
        <span class="col-n">02</span>
        <div class="col-diagrama flujo-diagrama">
          {flujo.map((f, i) => (
            <>
              <div class="flujo-nodo">
                <div class="flujo-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[f.icon]} /></div>
                <span>{f.texto}</span>
              </div>
              {i < flujo.length - 1 && <div class="conector conector-chica"></div>}
            </>
          ))}
        </div>
      </div>

      <div class="poster-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={arrowIcon} />
      </div>

      <div class="poster-col">
        <span class="col-n">03</span>
        <div class="col-diagrama tec-diagrama">
          {tecnologias.map((t) => (
            <div class="tec-chip">
              <div class="tec-icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[t.icon]} /></div>
              <span>{t.texto}</span>
            </div>
          ))}
          <div class="mini-tabla">
            {tabla.map((t) => (
              <div class="mini-tabla-row"><span>{t.cat}</span><span>{t.tec}</span></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .infografia{ background: var(--negro); padding: 54px 0; }
  .mapa-kicker{ display: block; text-align: center; font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--naranja); margin-bottom: 26px; }

  .poster{
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: start;
    max-width: 1160px; margin: 0 auto;
    background: #1C1D18;
    border-radius: 20px;
    padding: 34px 30px;
  }
  .poster-linea{ grid-column: 1 / -1; height: 1px; background: rgba(236,115,35,0.22); margin-bottom: 22px; }
  .poster-col{ position: relative; min-width: 0; }
  .col-n{ font-family: var(--font-mono); font-size: 11px; font-weight: 700; color: var(--naranja); opacity: 0.85; display: block; margin-bottom: 20px; }

  .poster-arrow{ display: flex; align-items: flex-start; justify-content: center; padding: 6px 14px 0; color: var(--naranja); opacity: 0.4; }
  .poster-arrow svg{ width: 18px; height: 18px; }

  /* Columna 1: arquitectura */
  .nivel-box{ display: flex; align-items: center; gap: 14px; }
  .nivel-icono{ flex: 0 0 40px; width: 40px; height: 40px; border-radius: 10px; background: rgba(113,120,26,0.18); color: var(--verde); display: flex; align-items: center; justify-content: center; }
  .nivel-icono svg{ width: 21px; height: 21px; }
  .nivel-texto{ display: flex; flex-direction: column; gap: 3px; }
  .nivel-nombre{ font-size: 13.5px; font-weight: 700; color: #fff; }
  .nivel-items{ font-size: 11.5px; color: #B9B2A0; }
  .conector{ width: 2px; height: 20px; background: rgba(251,242,226,0.18); margin: 4px 0 4px 20px; }

  /* Columna 2: flujo */
  .flujo-nodo{ display: flex; align-items: center; gap: 12px; }
  .flujo-icono{ flex: 0 0 34px; width: 34px; height: 34px; border-radius: 50%; background: rgba(236,115,35,0.16); color: var(--naranja); display: flex; align-items: center; justify-content: center; }
  .flujo-icono svg{ width: 18px; height: 18px; }
  .flujo-nodo span{ font-size: 13px; font-weight: 600; color: #fff; }
  .conector-chica{ height: 14px; margin: 2px 0 2px 17px; }

  /* Columna 3: tecnologías */
  .tec-diagrama{ display: flex; flex-direction: column; gap: 12px; }
  .tec-chip{ display: flex; align-items: center; gap: 12px; }
  .tec-icono{ flex: 0 0 34px; width: 34px; height: 34px; border-radius: 50%; background: rgba(251,242,226,0.1); color: var(--crema); display: flex; align-items: center; justify-content: center; }
  .tec-icono svg{ width: 17px; height: 17px; }
  .tec-chip span{ font-size: 12.5px; font-weight: 600; color: #fff; }

  .mini-tabla{ margin-top: 18px; border-top: 1px solid rgba(251,242,226,0.14); padding-top: 14px; display: flex; flex-direction: column; gap: 7px; }
  .mini-tabla-row{ display: flex; justify-content: space-between; font-size: 11px; color: #B9B2A0; }
  .mini-tabla-row span:last-child{ color: #fff; font-weight: 600; }

  @media (max-width: 900px){
    .poster{ grid-template-columns: 1fr; padding: 28px 22px; row-gap: 0; }
    .poster-arrow{ justify-content: flex-start; padding: 10px 0 10px 18px; }
    .poster-arrow svg{ transform: rotate(90deg); }
  }
</style>
