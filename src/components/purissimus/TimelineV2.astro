---
const etapas = [
  { n: 1, texto: 'Incorporación al área de Sistemas y soporte a la infraestructura informática.', icon: 'monitor' },
  { n: 2, texto: 'Administración de la red corporativa, estaciones de trabajo y sistemas Windows.', icon: 'red' },
  { n: 3, texto: 'Participación en la actualización tecnológica de la infraestructura y adecuación para el cambio de milenio (Y2K).', icon: 'reloj' },
  { n: 4, texto: 'Integración con los sistemas de trazabilidad basados en Access, balanzas industriales y códigos de barras.', icon: 'barras' },
  { n: 5, texto: 'Participación en el soporte a la automatización del área de hemoderivados mediante PLC Siemens S7-300.', icon: 'plc' },
  { n: 6, texto: 'Trabajo conjunto con Producción, Dirección Técnica y Asuntos Regulatorios en la resolución de incidencias críticas y auditorías.', icon: 'equipo' },
  { n: 7, texto: 'Consolidación de una metodología de trabajo basada en documentación técnica, trazabilidad y continuidad operativa.', icon: 'doc' },
];

const icons: Record<string, string> = {
  monitor: '<rect x="3" y="4" width="18" height="12" rx="1.5"/><line x1="8" y1="20" x2="16" y2="20"/><line x1="12" y1="16" x2="12" y2="20"/>',
  red: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><line x1="8" y1="7.5" x2="10.5" y2="16"/><line x1="16" y1="7.5" x2="13.5" y2="16"/><line x1="8.5" y1="6" x2="15.5" y2="6"/>',
  reloj: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3.5 2"/>',
  barras: '<line x1="4" y1="5" x2="4" y2="19"/><line x1="7.5" y1="5" x2="7.5" y2="19"/><line x1="10" y1="5" x2="10" y2="19"/><line x1="14" y1="5" x2="14" y2="19"/><line x1="17" y1="5" x2="17" y2="19"/><line x1="20" y1="5" x2="20" y2="19"/>',
  plc: '<rect x="5" y="5" width="14" height="14" rx="1.5"/><line x1="8" y1="9" x2="14" y2="9"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="12" y2="17"/>',
  equipo: '<circle cx="8" cy="8" r="2.5"/><circle cx="16" cy="8" r="2.5"/><path d="M3.5 19c0-3 2-5 4.5-5s4.5 2 4.5 5"/><path d="M11.5 19c0-3 2-5 4.5-5s4.5 2 4.5 5"/>',
  doc: '<path d="M6 3h9l3 3v15H6z"/><line x1="15" y1="3" x2="15" y2="6"/><line x1="18" y1="6" x2="15" y2="6"/><line x1="8.5" y1="11" x2="15.5" y2="11"/><line x1="8.5" y1="15" x2="15.5" y2="15"/>',
};
---
<section class="v2sec v2sec-crema" id="evolucion">
  <div class="wrap">
    <div class="kicker">Evolución del proyecto · 2001–2004</div>
    <div class="timeline">
      {etapas.map((e) => (
        <div class="etapa">
          <div class="etapa-icono">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[e.icon]} />
          </div>
          <span class="etapa-n">{e.n}</span>
          <p>{e.texto}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .v2sec-crema{ background: var(--crema); }
  .kicker{ font-family: var(--font-mono); font-size: 12.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--verde); margin-bottom: 40px; text-align: center; }

  .timeline{ display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; max-width: 1100px; margin: 0 auto; }
  .etapa{ background: #fff; border-radius: 14px; padding: 22px 20px; text-align: center; position: relative; }
  .etapa-icono{ width: 48px; height: 48px; border-radius: 50%; background: var(--fondo-claro); color: var(--naranja); display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
  .etapa-icono svg{ width: 24px; height: 24px; }
  .etapa-n{ position: absolute; top: 14px; right: 16px; font-family: var(--font-mono); font-size: 11px; font-weight: 700; color: var(--verde); }
  .etapa p{ font-size: 13px; line-height: 1.5; color: var(--negro); margin: 0; }

  @media (max-width: 1000px){
    .timeline{ grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px){
    .kicker{ margin-bottom: 28px; }
    .timeline{ grid-template-columns: 1fr 1fr; gap: 12px; }
    .etapa{ padding: 18px 14px; }
    .etapa p{ font-size: 12.5px; }
  }
</style>
