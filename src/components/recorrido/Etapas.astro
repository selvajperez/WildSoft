---
import { Image } from 'astro:assets';
import purissimus from '../../assets/recorrido/wildfox-purissimus.png';
import lan from '../../assets/recorrido/wildfox-lan.png';
import wildsoft from '../../assets/recorrido/wildfox-wildsoft.png';
import docente from '../../assets/recorrido/wildfox-docente.png';

const icons: Record<string, string> = {
  planilla: '<rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="9" y1="4" x2="9" y2="20"/><line x1="15" y1="4" x2="15" y2="20"/>',
  db: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v12c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12c0 1.7 3.1 3 7 3s7-1.3 7-3"/>',
  web: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.5 4 6 4 9s-1.5 6.5-4 9c-2.5-2.5-4-6-4-9s1.5-6.5 4-9z"/>',
};

const etapas = [
  {
    periodo: '1993 – 1999',
    titulo: 'Primeros sistemas y gestión',
    texto: 'Mis primeros años estuvieron ligados a organizar información y resolver necesidades de gestión con planillas de cálculo, bases de datos y herramientas como Quattro Pro, en una época donde muchas tareas todavía eran manuales. Fue el inicio de una forma de trabajo que se mantendría siempre: observar cómo circula la información y buscar la solución que simplifique el trabajo cotidiano.',
    tipo: 'icono',
    icon: 'planilla',
  },
  {
    periodo: '1999 – 2004',
    titulo: 'Purissimus',
    texto: 'En un entorno industrial y farmacéutico, participé en la integración entre sistemas de información y automatización industrial: trazabilidad de sachets de plasma con Access, códigos de barras y balanza RS-232, y control de producción con PLC Siemens S7-300, sensores y válvulas. Una etapa que exigía precisión y que consolidó la importancia de conectar tecnología, operación y personas.',
    tipo: 'imagen',
    imagen: purissimus,
    alt: 'WildFox con casco de seguridad en un entorno industrial farmacéutico, representando la etapa Purissimus',
  },
  {
    periodo: '2004 – 2007',
    titulo: 'Molino Chacabuco',
    texto: 'Profundicé mi trabajo con bases de datos SQL, transformando información de distintas áreas del negocio en consultas, controles y reportes para el seguimiento operativo. Consolidé una mirada analítica: comprender qué necesitaba cada sector y devolver información confiable para decidir.',
    tipo: 'icono',
    icon: 'db',
  },
  {
    periodo: '2007 – 2009',
    titulo: 'LAN Argentina',
    texto: 'Asumí la responsabilidad sobre el software de la operación local, en un entorno donde los sistemas sostenían procesos críticos de aeropuertos y comercialización. Combiné análisis, soporte, coordinación y gestión de proveedores, como enlace entre Argentina, equipos técnicos externos y las áreas de sistemas de Chile.',
    tipo: 'imagen',
    imagen: lan,
    alt: 'WildFox con auriculares de call center en un entorno aeroportuario, representando la etapa en LAN Argentina',
  },
  {
    periodo: '2010 – 2015',
    titulo: 'E-commerce y proyectos digitales',
    texto: 'Trabajé en proyectos de comercio electrónico y presencia digital: relevamiento, planificación, administración de servidores, mantenimiento de sitios y coordinación de mejoras sobre plataformas como Joomla y PrestaShop. Una etapa centrada en conectar tecnología, negocio y experiencia del usuario.',
    tipo: 'icono',
    icon: 'web',
  },
  {
    periodo: '2016 – actualidad',
    titulo: 'WildSoft',
    texto: 'WildSoft nació como un espacio propio para desarrollar soluciones tecnológicas y reunir experiencias construidas en distintos ámbitos: análisis funcional, desarrollo web, automatización y soporte a clientes. Con el tiempo incorporó análisis de datos, visualización y business intelligence con Python, SQL y Power BI.',
    tipo: 'imagen',
    imagen: wildsoft,
    alt: 'WildFox trabajando con Python, SQL y Power BI, representando la etapa actual en WildSoft',
  },
  {
    periodo: '2018 – actualidad',
    titulo: 'Docencia y comunicación',
    texto: 'Enseñé tecnología, matemática y herramientas digitales en educación secundaria y de adultos. La docencia fortaleció mi capacidad para explicar conceptos complejos, adaptar contenidos y sostener procesos en el tiempo: traducir lo técnico a un lenguaje comprensible.',
    tipo: 'imagen',
    imagen: docente,
    alt: 'WildFox frente a un pizarrón con fórmulas y gráficos, representando la etapa de docencia y comunicación',
  },
];
---
<section class="retapas" id="etapas">
  <div class="wrap">
    <div class="spine">
      {etapas.map((e, i) => (
        e.tipo === 'imagen' ? (
          <div class={`fila fila-imagen ${i % 2 === 0 ? 'fila-der' : 'fila-izq'}`}>
            <div class="fila-img">
              <Image src={e.imagen} alt={e.alt} widths={[320, 500, 640]} sizes="(max-width: 760px) 85vw, 380px" loading="lazy" />
            </div>
            <div class="fila-texto">
              <span class="periodo">{e.periodo}</span>
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
            </div>
          </div>
        ) : (
          <div class="fila fila-icono">
            <div class="icono-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[e.icon]} />
            </div>
            <div class="fila-texto">
              <span class="periodo">{e.periodo}</span>
              <h3>{e.titulo}</h3>
              <p>{e.texto}</p>
            </div>
          </div>
        )
      ))}
    </div>
  </div>
</section>

<style>
  .retapas{ background: #fff; padding: 80px 0; }
  .spine{ position: relative; max-width: 1080px; margin: 0 auto; }
  .spine::before{
    content: ''; position: absolute; top: 0; bottom: 0; left: 50%; width: 2px;
    background: rgba(21,22,18,0.1); transform: translateX(-50%);
  }

  .fila{ position: relative; display: flex; align-items: center; gap: 50px; margin-bottom: 70px; }
  .fila:last-child{ margin-bottom: 0; }

  /* Etapas con imagen: alternan lado */
  .fila-imagen.fila-der{ flex-direction: row; }
  .fila-imagen.fila-izq{ flex-direction: row-reverse; }
  .fila-img{ flex: 0 0 42%; }
  .fila-img :global(img){ width: 100%; height: auto; display: block; border-radius: 20px; }
  .fila-imagen .fila-texto{ flex: 1; }
  .fila-imagen.fila-der .fila-texto{ text-align: left; }
  .fila-imagen.fila-izq .fila-texto{ text-align: right; }

  /* Etapas solo ícono: centradas y angostas */
  .fila-icono{ justify-content: center; max-width: 640px; margin-left: auto; margin-right: auto; }
  .icono-badge{
    flex: 0 0 60px; width: 60px; height: 60px; border-radius: 50%; background: var(--fondo-claro);
    color: var(--naranja); display: flex; align-items: center; justify-content: center;
  }
  .icono-badge svg{ width: 30px; height: 30px; }
  .fila-icono .fila-texto{ flex: 1; text-align: left; }

  .periodo{ display: inline-block; font-family: var(--font-mono); font-size: 12.5px; font-weight: 700; letter-spacing: 0.08em; color: var(--verde); margin-bottom: 8px; }
  .fila-texto h3{ font-size: 22px; font-weight: 800; color: var(--negro); margin: 0 0 10px; }
  .fila-texto p{ font-size: 15px; line-height: 1.65; color: var(--gris); margin: 0; }

  @media (max-width: 900px){
    .fila-img{ flex: 0 0 38%; }
  }

  @media (max-width: 760px){
    .retapas{ padding: 50px 0; }
    .spine::before{ left: 0; }
    .fila, .fila-imagen.fila-der, .fila-imagen.fila-izq{ flex-direction: column; gap: 18px; margin-bottom: 46px; padding-left: 26px; }
    .fila-icono{ max-width: none; margin-left: 0; margin-right: 0; }
    .fila-img{ flex: none; width: 100%; }
    .fila-imagen .fila-texto, .fila-imagen.fila-der .fila-texto, .fila-imagen.fila-izq .fila-texto, .fila-icono .fila-texto{ text-align: left; flex: none; width: 100%; }
    .fila-texto h3{ font-size: 19px; }
    .fila-texto p{ font-size: 14px; }
    .icono-badge{ margin-left: 0; }
  }
</style>
