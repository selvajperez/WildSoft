---
import CasoLayout from '../../../layouts/CasoLayout.astro';
import { getCasosVisibles } from '../../../lib/casos';
import { getConexiones, getRelacionados } from '../../../lib/relacionados';

// Un caso, una página: /lab/casos/<nombre del YAML>. Los borradores solo se
// generan en desarrollo.
export async function getStaticPaths() {
  const casos = await getCasosVisibles();
  return casos.map((caso) => ({
    params: { slug: caso.id },
    props: { caso },
  }));
}

const { caso } = Astro.props;
// Las conexiones se muestran por eje; las demás relaciones, aparte.
const conexiones = await getConexiones(caso);
const enConexiones = new Set(conexiones.flatMap((c) => c.lecturas.map((l) => l.href)));
const lecturas = (await getRelacionados('casos', caso.id)).filter((l) => !enConexiones.has(l.href));
---
<CasoLayout caso={caso} lecturas={lecturas} conexiones={conexiones} />
