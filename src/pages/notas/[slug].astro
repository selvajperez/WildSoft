---
import { getCollection } from 'astro:content';
import NotaLayout from '../../layouts/NotaLayout.astro';

export async function getStaticPaths() {
  const notas = await getCollection('notas');
  return notas.map((nota) => ({
    params: { slug: nota.slug },
    props: { nota },
  }));
}

const { nota } = Astro.props;
const { Content } = await nota.render();

const palabras = nota.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.round(palabras / 200));
---
<NotaLayout
  title={nota.data.title}
  description={nota.data.description}
  pubDate={nota.data.pubDate}
  tags={nota.data.tags}
  heroImage={nota.data.heroImage}
  readingTime={readingTime}
  siguienteLabel={nota.data.siguienteLabel}
  siguientePeriodo={nota.data.siguientePeriodo}
  siguienteTexto={nota.data.siguienteTexto}
  siguienteHref={nota.data.siguienteHref}
  siguienteLinkTexto={nota.data.siguienteLinkTexto}
>
  <Content />
</NotaLayout>
