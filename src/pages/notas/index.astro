---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const notasSinOrdenar = await getCollection('notas');
const notas = notasSinOrdenar.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="Notas y reflexiones — WildSoft"
  description="Apuntes, comentarios y reflexiones sobre datos, tecnología, proyectos, aprendizaje y trabajo."
>
  <Header />

  <section id="notas-listado">
    <div class="section-head">
      <h1>Ideas que aparecen mientras sigo el camino</h1>
      <p>Apuntes, comentarios y reflexiones sobre datos, tecnología, proyectos, aprendizaje y trabajo. Una bitácora abierta para registrar decisiones, preguntas, descubrimientos y todo aquello que también forma parte del proceso.</p>
    </div>

    <div class="notas-grid wrap">
      {notas.map((nota) => {
        const fecha = nota.data.pubDate.toLocaleDateString('es-AR', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          timeZone: 'UTC',
        });
        return (
          <a class="nota-card" href={`/notas/${nota.slug}`}>
            <div class="nota-card-tags">
              {nota.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <h2>{nota.data.title}</h2>
            <p class="desc">{nota.data.description}</p>
            <p class="fecha">{fecha}</p>
            <span class="link">Leer la nota →</span>
          </a>
        );
      })}
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  #notas-listado{ padding-bottom: 150px; }
  .notas-grid{ display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; padding: 0; }
  .nota-card{
    background: var(--crema);
    border-radius: 16px;
    padding: 32px 30px;
    border-left: 5px solid var(--naranja);
    display: block;
  }
  .nota-card-tags{ display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
  .nota-card-tags .tag{
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    padding: 5px 12px; border-radius: 20px; border: 1px solid var(--naranja); color: var(--naranja);
  }
  .nota-card h2{ font-size: 21px; font-weight: 800; margin: 0 0 10px; color: var(--negro); }
  .nota-card .desc{ font-size: 15px; line-height: 1.6; color: var(--gris); margin: 0 0 14px; }
  .nota-card .fecha{ font-size: 12.5px; color: var(--gris); opacity: 0.75; margin: 0 0 16px; }
  .nota-card .link{ font-size: 14.5px; font-weight: 700; color: var(--naranja); }

  @media (max-width: 760px){
    #notas-listado{ padding-bottom: 90px; }
    .notas-grid{ display: flex; flex-direction: column; gap: 16px; }
    .nota-card{ padding: 26px 22px; border-radius: 14px; }
    .nota-card h2{ font-size: 19px; }
    .nota-card .desc{ font-size: 14.5px; }
  }
</style>
